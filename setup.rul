	RegDBDeleteKey(szStartRunKey ^ "ESQ_AOSetup");
	//end here
	// To delete Files and Short cut for older than AO 3.3.1
	DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET" ^"Documents","AO 3.3 Release Document");
	DeleteFile(TARGETDIR ^ "DOC" ^"AO 3.3 Release Document.pdf ");
	DeleteFile(TARGETDIR ^ "DOC" ^"AO 3.3 User and Installation Guide.pdf");
	// For AO 40 remove previous file and links
	DeleteFile(TARGETDIR ^ "DOC" ^"Concepts Guide.pdf");
	DeleteFile(TARGETDIR ^ "DOC" ^"Console Guide.pdf");
	DeleteFile(TARGETDIR ^ "DOC" ^"Reporter Guide.pdf");
	DeleteFile(TARGETDIR ^ "DOC" ^"ObjectMAP Guide.pdf");
	DeleteFile(TARGETDIR ^ "DOC" ^"AO 3.3.1 User and Installation Guide.pdf");
	//Changes for startup shortcuts in AO 40
	DeleteFile(TARGETDIR ^ "DOC" ^"AO 3.0 User Manual.pdf");
	DeleteFile(TARGETDIR ^ "DOC" ^"AO Configuration Client.pdf");
	DeleteFile(TARGETDIR ^ "DOC" ^"AO Live.pdf");
	DeleteFile(TARGETDIR ^ "DOC" ^"ObjectMAP.pdf");
	DeleteFile(TARGETDIR ^ "DOC" ^"Reporter.pdf");
	DeleteFile(TARGETDIR ^ "DOC" ^"AO 3.3.1 Release Document.pdf");
	//Delete File for AO 4.0.3
	DeleteFile(TARGETDIR ^ "DOC" ^"AO 4.0 Release Document.pdf");
	
	
	DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET","Uninstall AO");
	DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET" ^"Documents","AO 3.3.1 Release Document");
	DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET","ReadMe");	
    DeleteProgramFolder(FOLDER_PROGRAMS ^ "OpenNET" ^"Console");
    DeleteProgramFolder(FOLDER_PROGRAMS ^ "OpenNET" ^"Reporter");
    DeleteProgramFolder(FOLDER_PROGRAMS ^ "OpenNET" ^"ObjectMap");
    DeleteProgramFolder(FOLDER_PROGRAMS ^ "OpenNET" ^"Documents");	
    DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET" ^"AO","AO");
    DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET" ^"Elink","Health");
    DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET" ^"Elink","Elink Manager");
    DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET" ^"Elink","Configure Elink");
    DeleteProgramFolder(FOLDER_PROGRAMS ^ "OpenNET" ^"AO7A0C~1");
    DeleteDir(FOLDER_PROGRAMS ^ "OpenNET" ^"AO7A0C~1",ALLCONTENTS);
    //end here 
    
    //For AO 5.0
    DeleteFile(TARGETDIR ^ "Back end"  ^"AOPAKI");
    DeleteFile(TARGETDIR ^ "Back end"  ^"AOTIMEI");
    DeleteFile(TARGETDIR ^ "Back end" ^ "AO_Host_Installation.chm");
    DeleteFile(TARGETDIR ^ "Back end" ^ "AO_Host_Management.chm");
    DeleteFile(TARGETDIR ^ "Back end" ^ "Host_Installation.chm");
    DeleteFile(TARGETDIR ^ "Back end" ^ "Host_Management.chm");
    DeleteFile(TARGETDIR ^ "AO" ^ "Pager95.exe");
    DeleteFile(TARGETDIR ^ "AO" ^ "Mail95.exe");
    DeleteFile(TARGETDIR ^ "AO" ^ "PagerApp.exe");
    RegDBDeleteValue ( "Software\\Microsoft\\Windows\\CurrentVersion\\Run", "ESQ_Elink_For_Windows" ); 
    DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET" ^"Elink","Start Elink");
    //changes end here  
    
