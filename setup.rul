// Attaching EventDB DataBase
function BOOL AttachAOLoggerDB() 
STRING sServerName, sDBPath, sDBFiles, szTarget;
OBJECT oSQLServer;
NUMBER nvType, nvSize, Error; 
BOOL bOBJECT; 
STRING sResult, szMsg;
NUMBER nTryCount;
begin
  	nTryCount = 0; 
  	RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE); 
	szTarget=TARGETDIR ^ "Logger\\DataBase";
	LongPathToShortPath(szTarget);
	sDBPath = szTarget;
  	sDBFiles = sDBPath + "\\" + sDBName + "_Data.mdf," + sDBPath + "\\" + sDBName + "_Log.ldf";
    bOBJECT = FALSE;  
    try 
  		set oSQLServer = CreateObject("SQLDMO.SQLServer") ;
  		bOBJECT = IsObject(oSQLServer);             
	catch 
		Error = Err.Number;     
		/* changed by YK on 03Dec2004 */
		szMsg = "Error in attaching OpenNETLoggerDB database to OpenNET.\n"
		        +Err.Description;
		MessageBox(szMsg,SEVERE);
		return FALSE;	
	endcatch;  		
  	if(bOBJECT = FALSE)	then
  		szMsg = "Error in attaching OpenNETLoggerDB database to OpenNET.";
		MessageBox(szMsg,SEVERE);
		return FALSE;	
  	endif;
	sServerName = ".\\OPENNET";
	sResult = "";                                             
	/*Next line added by YK on 03Dec2004 */     
	oSQLServer.LoginSecure = FALSE;
	oSQLServer.Name = sServerName;
	if oSQLServer.Status != 1 then
		oSQLServer.Start(TRUE, sServerName, sSQLUserName, sDBPwd);
	endif;
Login:	               
	Delay(2);
	try    
		oSQLServer.Connect(sServerName, sSQLUserName, sDBPwd);	
		sResult = "";
	catch     
		/* changed by YK on 03Dec2004 */
		sResult = "Error in attaching OpenNETLoggerDB database to OpenNET.\n"
		          + Err.Description; 
	endcatch;
	nTryCount = nTryCount + 1;
	if(StrCompare(sResult,"") != 0) then
		if(nTryCount > 3) then   
			if(AskYesNo("Invalid Login ID and Password. Do you want to try again?",YES) = NO) then
				/* changed by YK on 03Dec2004 */
				szMsg = "Error in attaching OpenNETLoggerDB database to OpenNET.\n"
				        + Err.Description;
				MessageBox(szMsg,SEVERE);
				return FALSE;	
			endif;
		endif;            
		Disable(BACKBUTTON);
		if(nTryCount > 2) then
			LoginDlg(sSQLUserName, sDBPwd, GetWindowHandle (HWND_INSTALL));
		endif;			
		goto Login;
	else
		try      
			sResult = oSQLServer.DetachDB(sDBName);
		catch                  
			sResult = "";
		endcatch;
		try
			sResult = oSQLServer.AttachDB(sDBName, sDBFiles); 
			sResult = oSQLServer.Disconnect();	
		catch
			/* changed by YK on 03Dec2004 */ 
			szMsg = "Error in attaching OpenNETLoggerDB database to OpenNET.\n"
			        + Err.Description;
			MessageBox(szMsg,SEVERE);
			return FALSE;
		endcatch;						
	endif;	
	return TRUE;	
end;  

// Detaching EventDB DataBase 
function BOOL DetachAOLoggerDB() 
STRING sServerName, sDBPath, sDBFiles, szTarget;
OBJECT oSQLServer,SQL2000;
NUMBER nvType, nvSize, Error; 
BOOL bOBJECT; 
STRING sResult, szMsg;  
NUMBER nTryCount;
LONG SQLSrvrID;
NUMBER TotalCount,DataBaseCount,i;
STRING DataBaseName;
begin
	nTryCount = 0;
	bNoDatabases=FALSE;
  	set SQL2000 = CreateObject("SQLDMO.Application");
    try 
  		set oSQLServer = CreateObject("SQLDMO.SQLServer") ;
  		bOBJECT = IsObject(oSQLServer);             
	catch 
		Error = Err.Number;      
		/* changed by YK on 03Dec2004 */
		szMsg = "Error in detaching OpenNETLoggerDB database from OpenNET.\n"
		        + Err.Description;
		MessageBox(szMsg,SEVERE);
		return FALSE;	
	endcatch;  		
  	if(bOBJECT = FALSE)	then
  		szMsg = "Error in detaching OpenNETLoggerDB database from OpenNET.";
		MessageBox(szMsg,SEVERE);
		return FALSE;	
  	endif;
	sServerName = ".\\OPENNET";
	sResult = ""; 
	/* Added by YK on 03Dec2004 */
	oSQLServer.LoginSecure = FALSE;
	oSQLServer.Name = sServerName;
	if oSQLServer.Status != 1 then
		oSQLServer.Start(TRUE, sServerName, sSQLUserName, sDBPwd);
	endif; 
Login:	
	try    
		oSQLServer.Connect(sServerName, sSQLUserName, sDBPwd);	
		sResult = "";
	catch  
		/* changed by YK on 03Dec2004 */
		sResult = "Error in detaching OpenNETLoggerDB database from OpenNET.\n"
		          + Err.Description; 
	endcatch;
	nTryCount = nTryCount + 1;
	if(StrCompare(sResult,"") != 0) then
		if(nTryCount > 3) then   
			if(AskYesNo("Invalid Login ID and Password. Do you want to try again?",YES) = NO) then
				/* changed by YK on 03Dec2004 */
				szMsg = "Error in detaching OpenNETLoggerDB database from OpenNET.\n"
						+ Err.Description;
				MessageBox(szMsg,SEVERE);
				return FALSE;	
			endif;
		endif;            
		Disable(BACKBUTTON);   
		if(nTryCount > 2) then
			LoginDlg(sSQLUserName, sDBPwd, GetWindowHandle (HWND_INSTALL));
		endif;			
		goto Login;                    				
	else                                
		try
			sResult = oSQLServer.DetachDB(sDBName); 
			//Check Database in an OpeneNET Instance
			//Add by Sachin 13 DEC,2004
			SQLSrvrID = oSQLServer.ConnectionID;
			set oSQLServer =SQL2000.SQLServers.ItemByID(SQLSrvrID);
			TotalCount=oSQLServer.Databases.count;
			DataBaseCount=0;
			for i= 1 to TotalCount 
				if !(oSQLServer.Databases(i).SystemObject) then 
				    DataBaseCount=DataBaseCount+1;
				endif;    
			endfor;
			if  DataBaseCount > 0 then
					bNoDatabases=TRUE;
			elseif DataBaseCount = 0 then	
					bNoDatabases=FALSE;
			endif;
			//Changes end here
			sResult = oSQLServer.Disconnect();	
		catch 
			return FALSE;
		endcatch;						
	endif;	
	return TRUE;	
end;
 
//Removing EventDB Database
 function RemovingAOLoggerDB()    
	STRING szUpdateMsg, szProgram, szCmdLine;
	begin
		if(MAINTENANCE) then
			szProgram=WINSYSDIR ^"net.exe";
		    szCmdLine="start mssql$opennet";
		    LaunchAppAndWait  ( szProgram, szCmdLine, WAIT);
			szProgram=WINSYSDIR ^"net.exe";
			szCmdLine="start sqlagent$opennet";
			LaunchAppAndWait  ( szProgram, szCmdLine, WAIT);
			Delay(10);
			DetachAOLoggerDB();
		endif;
end;  
//Remove Logger Service
function RemoveLoggerService()
STRING szPath,szCmd;
begin
	//Event Logger Service removed
	szPath = WINSYSDIR ^ "net.exe";
	LongPathToQuote( szPath, TRUE );
	szCmd="stop emslogsvc";
	LongPathToQuote( szPath, TRUE );
	LaunchAppAndWait(szPath,szCmd,WAIT);
	szPath = TARGETDIR ^ "Logger" ^ "EmsSvc.exe";
	LongPathToQuote( szPath, TRUE );
	LaunchAppAndWait(szPath," -remove" ,WAIT);
	  //
end;
// TO Delete registry of Logger
function RemoveRegAOLogger()
STRING szStartRunKey,szStartupNSK; 
begin
	RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE);
	RegDBDeleteKey("Software\\ODBC\\ODBC.INI\\AOLoggerDB");
	RegDBDeleteValue("Software\\ODBC\\ODBC.INI\\ODBC Data Sources","AOLoggerDB");
	szStartRunKey  =  "Software\\Microsoft\\Windows\\CurrentVersion\\Run";
	szStartupNSK =  "ESQ_Logger_For_Windows";
	RegDBDeleteValue(szStartRunKey, szStartupNSK);
end;
// Uninstall OpenNET SQL Instance
function UnInstallOpenNETInstance()
STRING szUpdateMsg,szProgram,szCmdLine,szSQLInstanceName,szSQLPath,SQLPath;
NUMBER nvType,nvSize;
STRING szPath,szCmd,szBuffer,szFileName;
NUMBER nvFileHandle1;
STRING szOPENNETName,szComputerName;
begin
RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE);
	//Check OpenNET installed or not
	if RegDBGetKeyValueEx("SOFTWARE\\Microsoft\\Microsoft SQL Server\\OPENNET\\Setup", "ProductCode", nvType, szSQLInstanceName, nvSize)=0 then	
	 	//Check all the databases detached from OPENNET instance
	 	if bNoDatabases=FALSE then
		 	//If NSKEvent Logger is installed 
		 	if RegDBKeyExist("Software\\ODBC\\ODBC.INI\\NSKEventDB")<0  then
			 	//Check if AO Event Logger is not installed
			 	if bOldVisionReporterAgent=FALSE then
					 	RegDBGetKeyValueEx("SOFTWARE\\Microsoft\\Microsoft SQL Server\\OPENNET\\Setup", "SQLPath", nvType, szSQLPath, nvSize);
					 	//Check if OPENNET instance is installed by GatherNSK and if installed by other Application then will do further steps
					 	if StrCompare(szSQLPath,TARGETDIR ^ "Logger" ^ "MSSQL$OPENNET")=0 then
						 	szUpdateMsg = "Uninstalling OpenNET SQL Instance. Please Wait...";
							SdShowMsg (szUpdateMsg, TRUE);
							szProgram=WINSYSDIR ^"net.exe";
					    	szCmdLine="stop sqlagent$opennet";
					    	LaunchAppAndWait  ( szProgram, szCmdLine, WAIT);
							szProgram=WINSYSDIR ^"net.exe";
					    	szCmdLine="stop mssql$opennet";
					    	LaunchAppAndWait  ( szProgram, szCmdLine, WAIT);
			           		szProgram=TARGETDIR ^ "Logger" ^ "SQL" ^ "setup.exe";
					    	szCmdLine="/x "+szSQLInstanceName+" " + "/qn" ;
					    	LaunchAppAndWait  ( szProgram, szCmdLine, WAIT);
					    	bRemoveLogger=TRUE;
					    	Delay(2);
							SdShowMsg (szUpdateMsg, FALSE);
							RegDBDeleteKey ("Software\\Microsoft\\Microsoft SQL Server\\OPENNET");
							//To add by sachin on 11 Dec,2004
							RegDBDeleteKey("System\\CurrentControlSet\\Servcies\\mssql$opennet");
							RegDBDeleteKey("System\\CurrentControlSet\\Servcies\\sqlagent$opennet");
							if RegDBGetKeyValueEx("Software\\Microsoft\\MSSQLServer\\Client\\ConnectTo", ".\\OPENNET", nvType, szOPENNETName, nvSize)=0 then
								RegDBDeleteValue("Software\\Microsoft\\MSSQLServer\\Client\\ConnectTo",".\\OPENNET");
								RegDBGetKeyValueEx("System\\CurrentControlSet\\Control\\ComputerName\\ComputerName", "ComputerName", nvType, szComputerName, nvSize);
								RegDBDeleteValue("Software\\Microsoft\\MSSQLServer\\Client\\ConnectTo",szComputerName+"\\OPENNET");
							endif;
						else
							bRemoveLogger=TRUE;
					    	Delay(2);
					    	szProgram=WINSYSDIR ^"net.exe";
					    	szCmdLine="stop sqlagent$opennet";
					    	LaunchAppAndWait  ( szProgram, szCmdLine, WAIT);
					    	szProgram=WINSYSDIR ^"net.exe";
					    	szCmdLine="stop mssql$opennet";
					    	LaunchAppAndWait  ( szProgram, szCmdLine, WAIT);
					    	//Check OPENNET Instance directory exists if not then will do further steps 
					    	if ExistsDir(szSQLPath)=0 then
						    	DeleteFile(TARGETDIR ^ "Logger" ^ "SQL" ^"setup.ini");
						    	StrSub(SQLPath,szSQLPath,0,StrLength(szSQLPath)-StrLength("\MSSQL$OPENNET"));
						    	szPath = TARGETDIR ^ "Logger" ^ "SQL";
								szFileName = "setup.ini";
								OpenFileMode(FILE_MODE_BINARY);
								CreateFile (nvFileHandle1, szPath, szFileName);
								szBuffer= "[Options]"+"\r\n" +"INSTANCENAME=OPENNET" +"\r\n"+"BLANKSAPWD=1"+"\r\n"+ 
								"DISABLENETWORKPROTOCOLS=0" +"\r\n" + "SECURITYMODE=SQL"+"\r\n"+
								"ADDLOCAL=ALL" +"\r\n"+"ALLUSERS=1" +"\r\n"+
								"DATADIR=" +"\""+SQLPath+"\""+"\r\n"+ "TARGETDIR="+"\""+SQLPath+"\"";
								WriteBytes ( nvFileHandle1, szBuffer, 0, StrLength(szBuffer));
		        				CloseFile(nvFileHandle1);
								szUpdateMsg = "Uninstalling OpenNET SQL Instance. Please Wait...";
								SdShowMsg (szUpdateMsg, TRUE);
								szProgram=TARGETDIR ^ "Logger" ^ "SQL" ^ "setup.exe";
						    	szCmdLine="/x "+szSQLInstanceName+" " + "/qn" ;
						    	LaunchAppAndWait  ( szProgram, szCmdLine, WAIT);
								SdShowMsg (szUpdateMsg, FALSE);
								DeleteDir(szSQLPath,ALLCONTENTS);
								RegDBDeleteKey("System\\CurrentControlSet\\Servcies\\mssql$opennet");
								RegDBDeleteKey("System\\CurrentControlSet\\Servcies\\sqlagent$opennet");
							   	if RegDBGetKeyValueEx("Software\\Microsoft\\MSSQLServer\\Client\\ConnectTo", ".\\OPENNET", nvType, szOPENNETName, nvSize)=0 then
									RegDBDeleteValue("Software\\Microsoft\\MSSQLServer\\Client\\ConnectTo",".\\OPENNET");
									RegDBGetKeyValueEx("System\\CurrentControlSet\\Control\\ComputerName\\ComputerName", "ComputerName", nvType, szComputerName, nvSize);
									RegDBDeleteValue("Software\\Microsoft\\MSSQLServer\\Client\\ConnectTo",szComputerName+"\\OPENNET");
								endif;
						   else	
						    	if szSQLInstanceName !="" then
						    		RegDBDeleteKey("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\" + szSQLInstanceName);
						    	endif;
						    	RegDBDeleteKey ("Software\\Microsoft\\Microsoft SQL Server\\OPENNET");
						    	RegDBDeleteKey("System\\CurrentControlSet\\Servcies\\mssql$opennet");
								RegDBDeleteKey("System\\CurrentControlSet\\Servcies\\sqlagent$opennet");
								if RegDBGetKeyValueEx("Software\\Microsoft\\MSSQLServer\\Client\\ConnectTo", ".\\OPENNET", nvType, szOPENNETName, nvSize)=0 then
									RegDBDeleteValue("Software\\Microsoft\\MSSQLServer\\Client\\ConnectTo",".\\OPENNET");
									RegDBGetKeyValueEx("System\\CurrentControlSet\\Control\\ComputerName\\ComputerName", "ComputerName", nvType, szComputerName, nvSize);
									RegDBDeleteValue("Software\\Microsoft\\MSSQLServer\\Client\\ConnectTo",szComputerName+"\\OPENNET");
								endif;
							endif;
					    	bRemoveLogger=TRUE;
					    	if szSQLInstanceName !="" then
						    	RegDBDeleteKey("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\" + szSQLInstanceName);
						    endif;
							RegDBDeleteKey ("Software\\Microsoft\\Microsoft SQL Server\\OPENNET");
						endif;
				endif;
			endif;
		endif;
	endif;	
end;      

function OnFileLocked(szFileName)
STRING sFileName,szCmd;
begin 
	if( listLockedFiles == NULL) then
			listLockedFiles = ListCreate( STRINGLIST );  
			ListAddString(listLockedFiles,"Locked Files:-",AFTER);      		    	   
	endif;
	ListAddString(listLockedFiles,"    " + szFileName,AFTER);
	return ERR_PERFORM_AFTER_REBOOT;
end;

function OnFileReadOnly(szFileName) 
begin
	return ERR_YES;
end;
function MDacInstall()
STRING  svReturnString,szPath,szCmd,svReturnStringInstall,nResult;
begin
	ParsePath ( svReturnString, TARGETDIR,DISK ); 
   	svReturnString=svReturnString ^ "Progra~1" ^ "AOMdac";
 	//szPath =SUPPORTDIR ^ "j2re-1_4_2_03-windows-i586-p.exe";
 	if FindFile(svReturnString ,"dasetup.exe",nResult)<0 then
	 	szPath =TARGETDIR ^"Back end" ^ "MDAC_TYPE.EXE";
	 	LongPathToQuote( szPath, TRUE);
	    szCmd = "/t:"+ "\""+ svReturnString + "\"" +" "+"/c";
	 	LaunchAppAndWait  (szPath,szCmd, WAIT);
 		svReturnStringInstall=svReturnString ^ "setup.exe";
	 	szPath =TARGETDIR ^"Back end" ^ "MDAC_TYPE.EXE";
	 	LongPathToQuote( szPath, TRUE);
	    szCmd = "/q:a /c:"+ "\""+ svReturnStringInstall +" /q /n" +"\"";
	 	LaunchAppAndWait  (szPath,szCmd, WAIT);
	endif;
 end;
 
 function InstalledProductsRegSetKey()
NUMBER nvType,nvSize;
STRING svValue,svResult;
begin
	RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
   //To create AO registry
	   if (RegDBKeyExist("Software\\ESQ\\AO")=1) then
	   		if FindFile(TARGETDIR ^ "AO"  ,"AO.EXE",svResult)=0 then
		   		if (RegDBKeyExist("Software\\Installed Products\\AO")<0) then
			   		RegDBGetKeyValueEx ( "Software\\ESQ\\AO", "AppPath", nvType, svValue, nvSize );
			   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "AO","");
		 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "AO","",REGDB_STRING, "AO", -1 ) ;
			   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "AO","Application Name");
		 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "AO","Application Name",REGDB_STRING, "Configuration Client", -1 ) ;
			   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "AO", "Application Path");
					RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "AO", "Application Path",REGDB_STRING, svValue ^ "AO.exe", -1 );			 	
		   	  	endif;
		   	 endif;	
	   endif;    
	   
	   //To create AO Live registry
	   if (RegDBKeyExist("Software\\ESQ\\AO")=1) then
	   		if FindFile(TARGETDIR ^ "AO"  ,"AOLive.EXE",svResult)=0 then
		   		if (RegDBKeyExist("Software\\Installed Products\\AOLive")<0) then
			   		RegDBGetKeyValueEx ( "Software\\ESQ\\AO", "AppPath", nvType, svValue, nvSize );
			   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "AOLive","");
		 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "AOLive","",REGDB_STRING, "AOLive", -1 ) ;
			   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "AOLive","Application Name");
		 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "AOLive","Application Name",REGDB_STRING, "AOLive", -1 ) ;
			   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "AOLive", "Application Path");
					RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "AOLive", "Application Path",REGDB_STRING, svValue ^ "AOLive.exe", -1 );			 	
		   	  	endif;
		   	 endif;	
	   endif;
	   
	   //To Create HIC registry
	   if (RegDBKeyExist("Software\\ESQ\\BackEnd\\AO")=1) then
	   		if (RegDBKeyExist("Software\\Installed Products\\HIC")<0) then
		   		RegDBGetKeyValueEx ( "Software\\ESQ\\BackEnd\\AO", "Path", nvType, svValue, nvSize );
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "HIC","");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "HIC","",REGDB_STRING, "HIC", -1 ) ;
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "HIC","Application Name");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "HIC","Application Name",REGDB_STRING, "Host Installation Client", -1 ) ;
		   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "HIC", "Application Path");
				RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "HIC", "Application Path",REGDB_STRING, svValue ^ "HostInstallationClient.exe", -1 );			 	
	   	  endif;
	   endif;
	   //To create HMC Client
	    if (RegDBKeyExist("Software\\ESQ\\BackEnd\\AO")=1) then
	   		if (RegDBKeyExist("Software\\Installed Products\\HMC")<0) then
		   		RegDBGetKeyValueEx ( "Software\\ESQ\\BackEnd\\AO", "Path", nvType, svValue, nvSize );
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "HMC","");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "HMC","",REGDB_STRING, "HMC", -1 ) ;
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "HMC","Application Name");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "HMC","Application Name",REGDB_STRING, "Host Management Client", -1 ) ;
		   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "HMC", "Application Path");
				RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "HMC", "Application Path",REGDB_STRING, svValue ^ "HostManagementClient.exe", -1 );			 	
	   	  endif;
	   endif;
	   //To Create AO Reporter registry
	  if (RegDBKeyExist("Software\\ESQ\\AOReporter")=1) then
		  if FindFile(TARGETDIR ^"Reporter","Reporter.exe",svResult)=0 then
		   		if (RegDBKeyExist("Software\\Installed Products\\Reporter")<0) then
			   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "Reporter","");
		 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "Reporter","",REGDB_STRING, "Reporter", -1 ) ;
			   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "Reporter","Application Name");
		 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "Reporter","Application Name",REGDB_STRING, "Reporter", -1 ) ;
			   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "Reporter", "Application Path");
					RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "Reporter", "Application Path",REGDB_STRING, TARGETDIR ^"Reporter"^ "Reporter.exe", -1 );			 	
		   	  endif;
		   endif;
	   endif;
	   //To Create ObjectMAP registry
	 if FindFile(TARGETDIR ^"ObjectMap","ObjectMAP.exe",svResult)=0 then
	   	if (RegDBKeyExist("Software\\Installed Products\\ObjectMAP")<0) then
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "ObjectMAP","");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "ObjectMAP","",REGDB_STRING, "ObjectMAP", -1 ) ;
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "ObjectMAP","Application Name");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "ObjectMAP","Application Name",REGDB_STRING, "ObjectMAP", -1 ) ;
		   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "ObjectMAP", "Application Path");
				RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "ObjectMAP", "Application Path",REGDB_STRING, TARGETDIR ^"ObjectMAP"^ "ObjectMAP.exe", -1 );			 	
	   	 endif;
	 endif;
	 
	   //To Create Start Agnets registry
	  if FindFile(TARGETDIR ^"Elink","start.vbs",svResult)=0 then
	   		if (RegDBKeyExist("Software\\Installed Products\\StartAgents")<0) then
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "StartAgents","");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "StartAgents","",REGDB_STRING, "StartAgents", -1 ) ;
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "StartAgents","Application Name");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "StartAgents","Application Name",REGDB_STRING, "Start Agents", -1 ) ;
		   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "StartAgents", "Application Path");
				RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "StartAgents", "Application Path",REGDB_STRING, TARGETDIR ^ "Elink" ^ "start.vbs", -1 );			 	
	   	  endif;
	   endif;
	   //To Create stop Agnets registry
	 if FindFile(TARGETDIR ^"Elink","stop.vbs",svResult)=0 then
	   	if (RegDBKeyExist("Software\\Installed Products\\StopAgents")<0) then
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "StopAgents","");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "StopAgents","",REGDB_STRING, "StopAgents", -1 ) ;
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "StopAgents","Application Name");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "StopAgents","Application Name",REGDB_STRING, "Stop Agents", -1 ) ;
		   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "StopAgents", "Application Path");
				RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "StopAgents", "Application Path",REGDB_STRING, TARGETDIR ^ "Elink" ^ "stop.vbs", -1 );			 	
	   	 endif;
	 endif;
	 
	 //To Create Health Elink  registry changed by sachin 
	 if (RegDBKeyExist("Software\\ESQ\\Elink Manager")=1) then
	   	if (RegDBKeyExist("Software\\Installed Products\\Health")<0) then
		   		RegDBGetKeyValueEx ( "Software\\ESQ\\Elink Manager", "AppPath", nvType, svValue, nvSize );
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "Health","");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "Health","",REGDB_STRING, "Health", -1 ) ;
		   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "Health","Application Name");
	 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "Health","Application Name",REGDB_STRING, "Health", -1 ) ;
		   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "Health", "Application Path");
				RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "Health", "Application Path",REGDB_STRING, svValue ^ "HealthClient.exe", -1 );			 	
	   	 endif;
	 endif;

   //To create Event Logger registry
	   if (RegDBKeyExist("Software\\ESQ\\EMSLoggerService")=1) then
	   		if FindFile(TARGETDIR ^ "Logger"  ,"EMSStatus.exe",svResult)=0 then
		   		if (RegDBKeyExist("Software\\Installed Products\\EMSStatus")<0) then
			   		//RegDBGetKeyValueEx ( "Software\\ESQ\\AO", "AppPath", nvType, svValue, nvSize );
			   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "EMSStatus","");
		 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "EMSStatus","",REGDB_STRING, "EMSStatus", -1 ) ;
			   		RegDBCreateKeyEx ( "Software\\ESQ\\Installed Products\\"+ "EMSStatus","Application Name");
		 	    	RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\"+ "EMSStatus","Application Name",REGDB_STRING, "EMS Status", -1 ) ;
			   		RegDBCreateKeyEx  ( "Software\\ESQ\\Installed Products\\" + "EMSStatus", "Application Path");
					RegDBSetKeyValueEx ( "Software\\ESQ\\Installed Products\\" + "EMSStatus", "Application Path",REGDB_STRING, TARGETDIR ^ "Logger" ^ "EMSStatus.exe", -1 );			 	
		   	  	endif;
		   	 endif;	
	   endif;
end;

//This function will check system requirements
function CheckSystemDetails()
BOOL bUser,bInternet,bServicePack;
STRING svAdmin,svIEValue,svServicePack,svIESubValue;
NUMBER nvType, nvSize,nServicePack;
STRING ServicePack;
begin
	//To check Operating system,Service pack and inetrnet explorer
    bUser=FALSE;
    bInternet=FALSE;
    bServicePack=FALSE;
    RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE);
    RegDBGetKeyValueEx("Software\\Microsoft\\Internet Explorer","Version", nvType, svIESubValue, nvSize); 
    StrSub(svIEValue,svIESubValue,0,1);
     if SYSINFO.WIN9X.bWin9X=TRUE then
			MessageBox("AO "+IFX_PRODUCT_VERSION+" does not support to WINDOWS 95/98/ME Operating System.",SEVERE);
			abort;
	 else
		if SYSINFO.WINNT.bAdmin_Logged_On=TRUE then
			svAdmin="Administrator rights";
			bUser=FALSE;
		else
			svAdmin="User rights";
			bUser=TRUE;
		endif;
		if StrCompare(svIEValue,"5")< 0 then
			bInternet=TRUE;
		else
			bInternet=FALSE;
		endif; 
		NumToStr(svServicePack,SYSINFO.WINNT.nServicePack);
		ServicePack=" and Windows Service Pack " + svServicePack + ".";
		if SYSINFO.WINNT.bWinNT4=TRUE then
			if StrCompare(svServicePack,"6") <0 && StrCompare(svServicePack,"0") > 0 then
				bServicePack=TRUE;
			elseif StrCompare(svServicePack,"6") <0 && StrCompare(svServicePack,"0") = 0 then
            	bServicePack=TRUE;
            	ServicePack=". However no Windows Service Pack is installed.";  
            elseif StrCompare(svServicePack,"6")>=0  then
				bServicePack=FALSE;
			endif;
			if bUser=TRUE || bInternet=TRUE || bServicePack=TRUE then
				MessageBox("This workstation has " + svAdmin + ","+ " Internet Explorer Version " + svIEValue + ServicePack+"\r\n"+"\r\n"
				+ "The minimum requirements to install AO 5.3 on Windows NT are:"+"\r\n"
                + "- user should have Administrator rights"+"\r\n"
                + "- Windows Service Pack 6 or above"+"\r\n"
                + "- Internet Explorer Version 5 or greater"+"\r\n" +"\r\n"
				+"Please upgrade the system to meet the minimum requirements.",SEVERE);
				abort;       
			endif;
		endif;
		if SYSINFO.WINNT.bWinXP=TRUE then
			if StrCompare(svServicePack,"1") <0 then
				bServicePack=TRUE;
				ServicePack=". However no Windows Service Pack is installed.";
			else
				bServicePack=FALSE;
			endif;
			if bUser=TRUE || bInternet=TRUE || bServicePack=TRUE then
				MessageBox("This workstation has " + svAdmin + ","+ " Internet Explorer Version " + svIEValue + ServicePack+"\r\n"+"\r\n"
				+ "The minimum requirements to install AO 5.3 on Windows XP are:"+"\r\n"
                + "- user should have Administrator rights"+"\r\n"
                + "- Windows Service Pack 1 or above"+"\r\n"
                + "- Internet Explorer Version 5 or greater"+"\r\n" +"\r\n"
				+"Please upgrade the system to meet the minimum requirements.",SEVERE);
				abort;
			endif;
		endif;
		if SYSINFO.WINNT.bWin2000=TRUE then
			if StrCompare(svServicePack,"3") <0 && StrCompare(svServicePack,"0") > 0 then
				bServicePack=TRUE;
			elseif StrCompare(svServicePack,"3") <0 && StrCompare(svServicePack,"0") = 0 then
            	bServicePack=TRUE;
            	ServicePack=". However no Windows Service Pack is installed.";  
            elseif StrCompare(svServicePack,"3")>=0  then
				bServicePack=FALSE;
			endif;
			if bUser=TRUE || bInternet=TRUE || bServicePack=TRUE then
				MessageBox("This workstation has " + svAdmin + ","+ " Internet Explorer Version " + svIEValue + ServicePack+"\r\n"+"\r\n"
				+ "The minimum requirements to install AO 5.3 on Windows 2000 are:"+"\r\n"
                + "- user should have Administrator rights"+"\r\n"
                + "- Windows Service Pack 3 or above"+"\r\n"
                + "- Internet Explorer Version 5 or greater"+"\r\n" +"\r\n"
				+"Please upgrade the system to meet the minimum requirements.",SEVERE);
				abort;       
			endif;
		endif;
		if SYSINFO.WINNT.bWinServer2003=TRUE then
			if bUser=TRUE || bInternet=TRUE then
				MessageBox("This workstation has " + svAdmin + ","+ " Internet Explorer Version " + svIEValue + "."+"\r\n"+"\r\n"
				+ "The minimum requirements to install AO 5.3 on Windows 2003 Server are:"+"\r\n"
                + "- user should have Administrator rights"+"\r\n"
                + "- Internet Explorer Version 5 or greater"+"\r\n" +"\r\n"
				+"Please upgrade the system to meet the minimum requirements.",SEVERE);
				abort;
			endif;
		endif;
	endif;
end;
//end here



function UpdateHICINIfile()
NUMBER nPos, nvConfFileHandle,nvTmpConfFileHandle;
STRING nConf,szWebSource,svReturnString;
STRING szTarget,szTargetUserId,szTargetTrusted, szSource, svLine, svTmp, svTmp1;
STRING szWindows;
NUMBER nvSize,nvType;
STRING svTargetPath;
begin 
	//szSystemRoot32 = svSysdir ^ svName ^ "Local Settings" ^ "Application Data" ^ "AO"; 
	//szSystemRoot64 = svSysdir ^ svName ^ "AppData" ^ "Local" ^ "AO";
	RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE); 
	szSource= TARGETDIR ^"Back End" ;
	LongPathToShortPath(szSource);
	DeleteFile(TARGETDIR ^"Back End" ^"HIC.ini");
	
	//GetDisk ( szSource, svTargetPath);
	//svTargetPath=svTargetPath ^"Progra~1" ^ "OVNM" ; 
  	svTargetPath=TARGETDIR;
  	LongPathToShortPath(svTargetPath);  	
	OpenFileMode (FILE_MODE_NORMAL); 
	OpenFile(nvTmpConfFileHandle,szSource,"HIC_tmp.ini");
	OpenFileMode (FILE_MODE_APPEND); 
	CreateFile(nvConfFileHandle,szSource,"HIC.ini");
	while(GetLine(nvTmpConfFileHandle,svLine) == 0) 
	   
				
		nPos = StrFind(svLine,"TARGETDIR");
		if(nPos > 0) then
			nPos = StrFind(svLine,"TARGETDIR");
			StrSub(svTmp,svLine ,0,nPos);
			StrSub(svTmp1,svLine,nPos+StrLength("TARGETDIR"),StrLength(svLine));
			//5.3 changes						                             
			svLine = svTmp + szAllUsersLoc+ svTmp1; 
							
			
		endif;  
		 
		WriteLine(nvConfFileHandle,svLine);
	endwhile;                               
	CloseFile(nvConfFileHandle);
	CloseFile(nvTmpConfFileHandle);
	//RenameFile(TARGETDIR ^"Back End" ^"LaunchHMCFromOVO.txt" ,TARGETDIR ^"Back End" ^"LaunchHMCFromOVO.bat"); 	
end;   

function CreateStartStop() 
NUMBER nvStartHandle, nvStopHandle, nvStartBatHandle, nvStopBatHandle;
STRING szSource;
begin  
	szSource = TARGETDIR ^ "Elink";
	OpenFileMode (FILE_MODE_APPEND); 
	CreateFile(nvStartHandle,szSource,"start.vbs"); 
	CreateFile(nvStopHandle,szSource,"stop.vbs"); 
	//5.3 changes   
	//WriteLine(nvStartHandle,"Dim oShell");
	//WriteLine(nvStartHandle,"Set oShell = WScript.CreateObject (\"WSCript.shell\")");
	//WriteLine(nvStartHandle,"WScript.Sleep 200"); 
	WriteLine(nvStartHandle,"Dim objShellApp: Set objShellApp = CreateObject(\"Shell.Application\")");
	WriteLine(nvStartHandle,"Dim oShell");
	WriteLine(nvStartHandle,"Set oShell = WScript.CreateObject (\"WSCript.shell\")");
	WriteLine(nvStartHandle,"If WScript.arguments.length = 0 Then");
	WriteLine(nvStartHandle,"   objShellApp.ShellExecute \"wscript.exe \", Chr(34) & WScript.ScriptFullName & Chr(34) & \" trigger\", \"\", \"runas\", 1");
	WriteLine(nvStartHandle,"Else");
	WriteLine(nvStartHandle,"WScript.Sleep 200"); 
	
	WriteLine(nvStopHandle,"Dim objShellApp: Set objShellApp = CreateObject(\"Shell.Application\")");
	WriteLine(nvStopHandle,"Dim oShell");
	WriteLine(nvStopHandle,"Set oShell = WScript.CreateObject (\"WSCript.shell\")");
	WriteLine(nvStopHandle,"If WScript.arguments.length = 0 Then");
	WriteLine(nvStopHandle,"   objShellApp.ShellExecute \"wscript.exe \", Chr(34) & WScript.ScriptFullName & Chr(34) & \" trigger\", \"\", \"runas\", 1");
	WriteLine(nvStopHandle,"Else");
	WriteLine(nvStopHandle,"WScript.Sleep 200"); 
	
	if(ComponentIsItemSelected (MEDIA, "AO 2.0\\Elink Manager") = 1) then
		WriteLine(nvStartHandle,"oShell.run \"net start Elink\""); 
	endif;
	//WriteLine(nvStartHandle,"WScript.Sleep 200"); 
	WriteLine(nvStartHandle,"End If");
	CloseFile(nvStartHandle);   
      
	if(ComponentIsItemSelected (MEDIA, "AO 2.0\\Elink Manager") = 1) then
		WriteLine(nvStopHandle,"oShell.run \"net stop Elink\"");    
		LongPathToShortPath(szSource);
		WriteLine(nvStopHandle,"oShell.run \"" + szSource ^ "\\ElinkWin32.exe" + " -stop" +"\"");
	
	endif;
	//WriteLine(nvStopHandle,"WScript.Sleep 200"); 
	WriteLine(nvStopHandle,"End If");
	CloseFile(nvStopHandle);  
 end; 

