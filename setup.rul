function UpdateHICLogsfolder()
NUMBER nPos, nvConfFileHandle,nvTmpConfFileHandle;
STRING nConf,szWebSource,svReturnString;
STRING szTarget,szTargetUserId,szTargetTrusted, szSource, svLine, svTmp, svTmp1;
STRING szWindows;
NUMBER nvSize,nvType;
STRING svTargetPath;
STRING szBackendloc, szHIClogFolder32, szHIClogFolder64,szHIClogFolder;
begin 
    RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE); 
	szSource= TARGETDIR ^"Back End"; 
	LongPathToShortPath(szSource);
	szBackendloc = szSource;
	//LongPathToShortPath(szBackendloc);  
	//szHIClogFolder32 = szSystemRoot32 ^ "Back End";
	//szHIClogFolder64 = szSystemRoot64 ^ "Back End"; 
	szHIClogFolder = szAllUsersLoc ^ "Back End";
	
	DeleteFile(TARGETDIR ^"Back End" ^"shortcutHIC.bat"); 	
  	LongPathToShortPath(svTargetPath);  	
	OpenFileMode (FILE_MODE_NORMAL); 
	OpenFile(nvTmpConfFileHandle,szSource,"shortcutHIC_tmp.bat");
	OpenFileMode (FILE_MODE_APPEND); 
	CreateFile(nvConfFileHandle,szSource,"shortcutHIC.bat");
	while(GetLine(nvTmpConfFileHandle,svLine) == 0) 
				
		nPos = StrFind(svLine,"<Backendlocation>");
		if(nPos > 0) then
			nPos = StrFind(svLine,"<Backendlocation>");
			StrSub(svTmp,svLine ,0,nPos);
			StrSub(svTmp1,svLine,nPos+StrLength("<Backendlocation>"),StrLength(svLine));
			svLine = svTmp + szSource + svTmp1; 			
		endif;
		nPos = StrFind(svLine,"<hicloglocation>");
		if(nPos > 0) then
			nPos = StrFind(svLine,"<hicloglocation>");
			StrSub(svTmp,svLine ,0,nPos);
			StrSub(svTmp1,svLine,nPos+StrLength("<hicloglocation>"),StrLength(svLine));
			//if b64bitOS=FALSE then
				svLine = svTmp + szHIClogFolder + svTmp1;
			//else
			//	svLine = svTmp + szHIClogFolder64 + svTmp1;			
			//endif;   
	     endif;
		WriteLine(nvConfFileHandle,svLine);
	endwhile;                               
	CloseFile(nvConfFileHandle);
	CloseFile(nvTmpConfFileHandle);
	
end; 
function UpdateElinkLogsfolder()
NUMBER nPos, nvConfFileHandle,nvTmpConfFileHandle;
STRING nConf,szWebSource,svReturnString;
STRING szTarget,szTargetUserId,szTargetTrusted, szSource, svLine, svTmp, svTmp1;
STRING szWindows;
NUMBER nvSize,nvType;
STRING svTargetPath;
STRING szBackendloc, szHIClogFolder32, szHIClogFolder64,szHIClogFolder;
begin 
    RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE); 
	szSource= TARGETDIR ^"Elink"; 
	LongPathToShortPath(szSource);
	szBackendloc = szSource;
	//LongPathToShortPath(szBackendloc);  
	//szHIClogFolder32 = szSystemRoot32 ^ "Elink";
	//szHIClogFolder64 = szSystemRoot64 ^ "Elink";
	szHIClogFolder =  szAllUsersLoc ^ "Elink";
	DeleteFile(TARGETDIR ^"Elink" ^"shortcutElink.bat"); 	
  	LongPathToShortPath(svTargetPath);  	
	OpenFileMode (FILE_MODE_NORMAL); 
	OpenFile(nvTmpConfFileHandle,szSource,"shortcutElink_tmp.bat");
	OpenFileMode (FILE_MODE_APPEND); 
	CreateFile(nvConfFileHandle,szSource,"shortcutElink.bat");
	while(GetLine(nvTmpConfFileHandle,svLine) == 0) 
				
		nPos = StrFind(svLine,"<Backendlocation>");
		if(nPos > 0) then
			nPos = StrFind(svLine,"<Backendlocation>");
			StrSub(svTmp,svLine ,0,nPos);
			StrSub(svTmp1,svLine,nPos+StrLength("<Backendlocation>"),StrLength(svLine));
			svLine = svTmp + szSource + svTmp1; 			
		endif;
		nPos = StrFind(svLine,"<hicloglocation>");
		if(nPos > 0) then
			nPos = StrFind(svLine,"<hicloglocation>");
			StrSub(svTmp,svLine ,0,nPos);
			StrSub(svTmp1,svLine,nPos+StrLength("<hicloglocation>"),StrLength(svLine));
			//if b64bitOS=FALSE then
				svLine = svTmp + szHIClogFolder + svTmp1;
			//else
			//	svLine = svTmp + szHIClogFolder64 + svTmp1;			
			//endif;   
	     endif;
		WriteLine(nvConfFileHandle,svLine);
	endwhile;                               
	CloseFile(nvConfFileHandle);
	CloseFile(nvTmpConfFileHandle);
	
end; 
function UpdateElinkcfgfilefor32bit()
NUMBER nPos, nvConfFileHandle,nvTmpConfFileHandle;
STRING nConf,szWebSource,svReturnString;
STRING szTarget,szTargetUserId,szTargetTrusted, szSource, svLine, svTmp, svTmp1;
STRING szWindows;
NUMBER nvSize,nvType;
STRING svTargetPath;
STRING szElinkNewparam, szElinkcfg32, szElinkcfg64;
begin 
	szElinkNewparam = "5000000"+"\n\n"+"SET ELINK LISTENADD   localhost";
    RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE);
	szElinkcfg32 = szAllUsersLoc ^ "Elink";
	LongPathToShortPath(szElinkcfg32);
	//DeleteFile(TARGETDIR ^"Back End" ^"HIClogs.bat"); 	
  	LongPathToShortPath(svTargetPath);  	
	OpenFileMode (FILE_MODE_NORMAL); 
	OpenFile(nvTmpConfFileHandle,szElinkcfg32,"elink.cfg");
	OpenFileMode (FILE_MODE_APPEND); 
	CreateFile(nvConfFileHandle,szElinkcfg32,"elink_tmp.cfg");
	while(GetLine(nvTmpConfFileHandle,svLine) == 0) 				
	
		nPos = StrFind(svLine,"5000000");
		if(nPos > 0) then
			nPos = StrFind(svLine,"5000000");
			StrSub(svTmp,svLine ,0,nPos);
			StrSub(svTmp1,svLine,nPos+StrLength("5000000"),StrLength(svLine));
			
			svLine = svTmp + szElinkNewparam + svTmp1;			
			
			 
	     endif;
		WriteLine(nvConfFileHandle,svLine);
	endwhile;                               
	CloseFile(nvConfFileHandle);
	CloseFile(nvTmpConfFileHandle);
	RenameFile( szElinkcfg32 ^ "elink_tmp.cfg", szElinkcfg32 ^ "elink.cfg" );
	//DeleteFile(szElinkcfg32 ^ "elink.cfg");
end;

function UpdateElinkcfgfilefor64bit()
NUMBER nPos, nvConfFileHandle,nvTmpConfFileHandle;
STRING nConf,szWebSource,svReturnString;
STRING szTarget,szTargetUserId,szTargetTrusted, szSource, svLine, svTmp, svTmp1;
STRING szWindows;
NUMBER nvSize,nvType;
STRING svTargetPath;
STRING szElinkNewparam, szElinkcfg32, szElinkcfg64;
begin 
	szElinkNewparam = "5000000"+"\n"+"SET ELINK LISTENADD   localhost";
    RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE); 
	 
	szElinkcfg64 = szSystemRoot64 ^ "Elink";
	LongPathToShortPath(szElinkcfg64);
	 	
  	LongPathToShortPath(svTargetPath);  	
	OpenFileMode (FILE_MODE_NORMAL); 
	OpenFile(nvTmpConfFileHandle,szElinkcfg64,"elink.cfg");
	OpenFileMode (FILE_MODE_APPEND); 
	CreateFile(nvConfFileHandle,szElinkcfg64,"elink_tmp.cfg");
	while(GetLine(nvTmpConfFileHandle,svLine) == 0) 				
	
		nPos = StrFind(svLine,"5000000");
		if(nPos > 0) then
			nPos = StrFind(svLine,"5000000");
			StrSub(svTmp,svLine ,0,nPos);
			StrSub(svTmp1,svLine,nPos+StrLength("5000000"),StrLength(svLine));
			
			svLine = svTmp + szElinkNewparam + svTmp1;
			 
	     endif;
		WriteLine(nvConfFileHandle,svLine);
	endwhile;                               
	CloseFile(nvConfFileHandle);
	CloseFile(nvTmpConfFileHandle);
	DeleteFile(szElinkcfg64 ^ "elink.cfg");
	
end; 


function UpdateFolderAccessBatch()
NUMBER nPos, nvConfFileHandle,nvTmpConfFileHandle;
STRING nConf,szWebSource,svReturnString;
STRING szTarget, szSource, svLine, svTmp, svTmp1;
STRING szWindows;
NUMBER nvSize,nvType;

begin
      
	RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE);	
	
	szSource=TARGETDIR ^ "AO";
	DeleteFile(szSource ^ "Folderpermissions.bat"); 
	LongPathToShortPath(szSource);
	OpenFileMode (FILE_MODE_NORMAL); 
	OpenFile(nvTmpConfFileHandle,szSource,"Folderpermissions_Tmp.bat");
	OpenFileMode (FILE_MODE_APPEND); 
	CreateFile(nvConfFileHandle,szSource,"Folderpermissions.bat");
	while(GetLine(nvTmpConfFileHandle,svLine) == 0) 	         		
								
				nPos = StrFind(svLine,"<TargetDir>");
					if(nPos > 0) then
						nPos = StrFind(svLine,"<TargetDir>");
						StrSub(svTmp,svLine,0,nPos);
						StrSub(svTmp1,svLine,nPos+StrLength("<TargetDir>"),StrLength(svLine));					                             
						svLine = svTmp + TARGETDIR + svTmp1; 					
					endif;
				nPos = StrFind(svLine,"<configTargetDir>");
					if(nPos > 0) then
						nPos = StrFind(svLine,"<configTargetDir>");
						StrSub(svTmp,svLine,0,nPos);
						StrSub(svTmp1,svLine,nPos+StrLength("<configTargetDir>"),StrLength(svLine));
						//if b64bitOS=FALSE then					                             
							svLine = svTmp + szAllUsersLoc + svTmp1; 					
						//else 
						//	svLine = svTmp + szSystemRoot64 + svTmp1; 
						//endif;
					endif;	
			WriteLine(nvConfFileHandle,svLine);
	endwhile;                               
	CloseFile(nvConfFileHandle);
	CloseFile(nvTmpConfFileHandle);	
end; 
     
function SetControlPanelRemoveOption()
//Declare for REMOVE option
STRING szRemoveOption,szRemoveOptionPath;
NUMBER nPos,TotLen,nRemovePos,nLastPos;
NUMBER nvType,nvSize;
//
begin
	//Change By Sachin to select REMOVE option when we use ADD/REMOVE from control panel
 	RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE);
 	RegDBGetKeyValueEx("SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\0B2F11CC-9C08-4F6C-8561-85C7624F7955", "UninstallString", nvType, szRemoveOption, nvSize) ;
    TotLen=StrLength(szRemoveOption);
    nPos=StrFind(szRemoveOption,"-removeonly");
    nRemovePos=StrFind(szRemoveOption,"REMOVE");
    nLastPos= StrFind(szRemoveOption,"-l0x9");
    if nPos!=-1 then
	    StrSub(szRemoveOptionPath,szRemoveOption,0,nPos);
	    RegDBSetKeyValueEx ("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall" ^ PRODUCT_GUID, "UninstallString", REGDB_STRING, szRemoveOptionPath+"REMOVE",-1);
	elseif nRemovePos !=-1 && nPos =-1 then
	else
		StrSub(szRemoveOptionPath,szRemoveOption,0,nLastPos+StrLength("-l0x9"));
		if StrLength(szRemoveOption)=StrLength( szRemoveOptionPath) then
		   RegDBSetKeyValueEx ("SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\0B2F11CC-9C08-4F6C-8561-85C7624F7955", "UninstallString", nvType, szRemoveOptionPath+" REMOVE", nvSize);
		endif;
	endif;
 	//changes end here
end;


#include "ComponentEvents.rul"


//---------------------------------------------------------------------------
// OnUpdateUIBefore
//
// Update UI Sequence - Before Move Data
//
// The OnUpdateUIBefore event is called when the setup is running in update
// mode. By default this event displays UI that allows the end user to
// update the application to the current version.
//
// Note: This event will not be called automatically in a
// program...endprogram style setup.
//---------------------------------------------------------------------------
function OnUpdateUIBefore()
	string szTitle, szMsg, szIgnore, szVersionInstalled, szVersionSupported, szVersionUpdate;
	number nVersionInstalled;
	number nIgnore, nId, nMediaFlags;
	number nResult;
	string szJavaPath;
begin
	 SetFont (FONT_TITLE,STYLE_BOLD,"Arial");  
	if(nvDx > 790) then
		SetTitle( "OpenNET/AO "+IFX_PRODUCT_VERSION+" Maintenance", 24, RGB(50,77,148));                        
	else
		SetTitle( "OpenNET/AO "+IFX_PRODUCT_VERSION+" Maintenance", 16, RGB(50,77,148));		
	endif;	
	SetDisplayEffect (EFF_NONE);
    SetTitle( "OpenNET/AO "+IFX_PRODUCT_VERSION+"", 0, BACKGROUNDCAPTION );
	Enable( FULLWINDOWMODE );						   
	Enable( BACKGROUND );							  
	SetColor(BACKGROUND,RGB (255, 255, 255));  	
		
    PlaceWindow (BILLBOARD, 200, 150, UPPER_LEFT);
    if(nvDx < 610 ) then
    	PlaceBitmap (SUPPORTDIR ^ "Screen1.bmp", 10, 0, 0, FULLSCREENSIZE);
	elseif(nvDx < 810) then
	   PlaceBitmap (SUPPORTDIR ^ "Screen2.bmp", 10, 0, 0, FULLSCREENSIZE);
	else
	   PlaceBitmap (SUPPORTDIR ^ "Screen3.bmp", 10, 0, 0, FULLSCREENSIZE);
	endif;
	
	// Determine the update media type.	
	MediaGetData( MEDIA, MEDIA_FIELD_MEDIA_FLAGS, nMediaFlags, szIgnore );

	// Compare Versions
	nResult = VerProductCompareVersions();

	// Make sure that valid data was returned by VerProductCompareVersions
	if( nResult < ISERR_SUCCESS ) then
		szMsg = SdLoadString( IDS_IFX_ERROR_UPDATE_VERSION_COMPARE_FAILURE );
		MessageBox( szMsg, SEVERE );
		abort;
	endif;

	// Make sure that the product is installed.
	if( nResult = VERSION_COMPARE_RESULT_NOT_INSTALLED ) then
		// Note: This result should occur only for differential media, since OnFirstUIBefore
		// will be called by default for non-differential media in this case.
		szMsg = SdLoadString( IDS_IFX_ERROR_UPDATE_PRODUCT_NOT_INSTALLED );
		SdSubstituteProductInfo( szMsg );
		MessageBox( szMsg, SEVERE );
		abort;
	endif;	

	// Check whether the update is older than the currently installed version.
	if( nResult = VERSION_COMPARE_RESULT_OLDER ) then
		szMsg = SdLoadString( IDS_IFX_ERROR_UPDATE_NOT_APPROPRIATE );
		SdSubstituteProductInfo( szMsg );
		MessageBox( szMsg, SEVERE );
		abort;
	endif;

	// Verify that this update is appropriate for the version of the application that is installed.
	if( nResult = VERSION_COMPARE_RESULT_NEWER_NOT_SUPPORTED ) then
		szMsg = SdLoadString( IDS_IFX_ERROR_UPDATE_NOT_SUPPORTED );
		SdSubstituteProductInfo( szMsg );
		MessageBox( szMsg, SEVERE );
		abort;
	endif;

	// Check whether the update is needed.
	if( nResult = VERSION_COMPARE_RESULT_SAME ) then
		// Note: This result should occur only for differential media, since the setup
		// will display OnMaintUIBefore or OnFirstUIBefore by default if the versions match
		// for full setup media.
		szMsg = SdLoadString( IDS_IFX_WARNING_UPDATE_NOT_NEEDED );
		SdSubstituteProductInfo( szMsg );
		if( MessageBox( szMsg, MB_ICONEXCLAMATION | MB_YESNO ) != IDYES ) then
			abort;
		endif;
	endif;

	// Automatically select newly added features, do this before UI sequence in case so that
	// if a feature dialog is added, it reflects newly selected features.
	FeatureSelectNew( MEDIA, TRUE );

	// TODO: Enable this line if you want the update to to automatically uninstall
	// any features that are not contained in the media but are listed in the 
	// log file.
	// FeatureRemoveAllInLogOnly();

    //Initialize SQL
    OnSQLServerInitializeMaint();
	 
	//5.5.1 changes
	if (StrCompare(svOldProduct,"OpenNET/AO 6.0")< 0)then
		szUpdateMsg = "Removing older Java and Help files, please wait...";
		
		SdShowMsg (szUpdateMsg, TRUE);	
    
        szJavaPath=TARGETDIR ^ "Back End" ;
    	LongPathToShortPath(szJavaPath); 
    	    
    	//if ExistsDir(szJavaPath ^ "Java")=1 then
    	if (ExistsDir (szJavaPath ^ "Java") = EXISTS) then		
				
			DeleteFile( szJavaPath ^ "Java" ^ "bin"  ^ "*.*"); 
			DeleteFile( szJavaPath ^ "Java" ^ "lib"  ^ "*.*");			 
			DeleteFile( szJavaPath ^ "Java"  ^ "*.*"); 
			DeleteDir(szJavaPath ^ "Java" ^ "bin",ONLYDIR);
			DeleteDir(szJavaPath ^ "Java" ^ "bin",ALLCONTENTS); 
			DeleteDir(szJavaPath ^ "Java" ^ "lib",ONLYDIR);
			DeleteDir(szJavaPath ^ "Java" ^ "lib",ALLCONTENTS);		
			DeleteDir(szJavaPath ^ "Java", ONLYDIR);
			DeleteDir(szJavaPath ^ "Java",ALLCONTENTS);
				
		endif;
	
	
    	DeleteDir(TARGETDIR ^ "Back end" ^ "help",ONLYDIR);   
    	DeleteDir(TARGETDIR ^ "Back end" ^ "help",ALLCONTENTS);
    	DeleteDir(szAllUsersLoc ^ "Back End" ^ "help" ^ "hic_help", ALLCONTENTS);
    	DeleteDir(szAllUsersLoc ^ "Back End" ^ "help" ^ "hmc_help", ALLCONTENTS);
    endif;
    Delay(5);
    SdShowMsg (szUpdateMsg, FALSE);	
// Beginning of UI Sequence
Dlg_Start:

Dlg_SdWelcome:
	szTitle = "";
    //szMsg = SdLoadString( IDS_IFX_SDWELCOMMESSAGE_UPDATE_WELCOME );
    szMsg   = "Before proceeding, we suggest you close all open applications...";
    nResult = SdWelcome( szTitle, szMsg );
    if (nResult = BACK) goto Dlg_Start;

Dlg_ObjDialogs:
    nResult = ShowObjWizardPages( nResult );
    if (nResult = BACK) goto Dlg_SdWelcome; 

	if( nMediaFlags & MEDIA_FLAG_FORMAT_DIFFERENTIAL ) then
		// Differential installs patch media.
		FeaturePatch();
	else
		// Update reinstalls (updates) all features in media.
		FeatureReinstall();
	endif;

    // Added in 11.0 - Set appropriate StatusEx static text.
    //szMsg = SdLoadString( IDS_IFX_STATUSEX_STATICTEXT_UPDATEUI );
    szMsg = "Please wait while the Wizard is installing "+svOldProduct+" to " + IFX_PRODUCT_NAME +"." ;
	SdSubstituteProductInfo( szMsg );
    SetStatusExStaticText( szMsg );
    
   

end;

//---------------------------------------------------------------------------
// OnUpdateUIAfter
//
// Update Mode UI Sequence - After Move Data
//
// The OnUpdateUIAfter event called by OnShowUI after the file transfer
// of the setup when the setup is running in update mode. By default
// this event displays UI that informs the end user that the maintenance setup
// has been completed successfully.
//
// Note: This event will not be called automatically in a
// program...endprogram style setup.
//---------------------------------------------------------------------------
function OnUpdateUIAfter()
    STRING szTitle, szMsg1, szMsg2, szOption1, szOption2,szJavaPath;
    NUMBER bOpt1, bOpt2;
    NUMBER nvReturn;
begin
	 // szElinkdir=WINSYSDISK ^ "Documents and Settings" ^ "All Users" ^ "Application Data" ^ "ESQ" ^ "Elink";
     //For BE file move
    if bPakFile1=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile1,  TARGETDIR ^ "Back end" ^ svPakFile1 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile1,TARGETDIR ^ "Back end" ^ svPakFile1); 
    	endif;
    	nvReturn = FileCompare(svPackageloc  ^ svPakFile1,  TARGETDIR ^ "Back End" ^ svPakFile1 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPakFile1,TARGETDIR ^ "Back End" ^ svPakFile1); 
    	endif;
    endif; 
    
    if bPakFile2=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile2,  TARGETDIR ^ "Back end" ^ svPakFile2 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile2,TARGETDIR ^ "Back end" ^ svPakFile2); 
    	endif;
    	nvReturn = FileCompare(svPackageloc ^ svPakFile2,  TARGETDIR ^ "Back End" ^ svPakFile2 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPakFile2,TARGETDIR ^ "Back End" ^ svPakFile2); 
    	endif;
    endif; 
    
     if bPakFile3=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile3,  TARGETDIR ^ "Back end" ^ svPakFile3,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile3,TARGETDIR ^ "Back end" ^ svPakFile3); 
    	endif;
    	nvReturn = FileCompare(svPackageloc ^ svPakFile3,  TARGETDIR ^ "Back End" ^ svPakFile3 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPakFile3,TARGETDIR ^ "Back End" ^ svPakFile3); 
    	endif;
    endif;
    
    //OCC web changes
     if bOCCWebFile=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile4, szAllUsersLoc ^ "Back End" ^ svPakFile4, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPackageFolderName ^ svPakFile4, szAllUsersLoc ^ "Back End" ^ svPakFile4); 
    	endif;  
    	
    	nvReturn = FileCompare(svPackageloc ^ svPakFile4,  szAllUsersLoc ^ "Back End" ^ svPakFile4, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPakFile4, szAllUsersLoc ^ "Back End" ^ svPakFile4); 
    	endif;
    endif;
    
    //RBAC web changes
     if bRBACWebFile=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile5, szAllUsersLoc ^ "Back End" ^ svPakFile5, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPackageFolderName ^ svPakFile5, szAllUsersLoc ^ "Back End" ^ svPakFile5); 
    	endif;  
    	
    	nvReturn = FileCompare(svPackageloc ^ svPakFile5,  szAllUsersLoc ^ "Back End" ^ svPakFile5, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPakFile5, szAllUsersLoc ^ "Back End" ^ svPakFile5); 
    	endif;
    endif;
    
    //for derbydb changes
    if bderbydb=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svderbydb,  TARGETDIR ^ "Back End" ^ svderbydb, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPackageFolderName ^ svderbydb,TARGETDIR ^ "Back End" ^ svderbydb); 
    	endif;  
    	
    	nvReturn = FileCompare(svPackageloc ^ svderbydb,  TARGETDIR ^ "Back End" ^ svderbydb, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svderbydb,TARGETDIR ^ "Back End" ^ svderbydb); 
    	endif;
    endif;
    
    //end here
    if bReadMEFile=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svDocFolder ^ svReadMeFile,  TARGETDIR ^ "Back End" ^  svReadMeFile ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svDocFolder ^ svReadMeFile,TARGETDIR ^ "Back End" ^  svReadMeFile);
    		
    	endif;
    	
    	nvReturn = FileCompare(svPackageloc  ^ svReadMeFile,  TARGETDIR  ^ "Back End" ^  svReadMeFile ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svReadMeFile,TARGETDIR ^ "Back End" ^ svReadMeFile); 
    		
    	endif;
    	
    endif; 
    	//XCopyFile(TARGETDIR ^ "Elink" ^ "*.*", szElinkdir ^ "*.*", COMP_NORMAL);
    	
    	
		
    if bDocFile=FALSE then
    
    else
    		CopyFile(svPackageloc  ^ svDocFolder ^ svDocFile,TARGETDIR  ^ "Doc" ^ svDocFile); 
    		CopyFile(svPackageloc  ^ svDocFile ,TARGETDIR  ^ "Doc" ^ svDocFile);
    
   
    endif;  
      		
	Disable(STATUSDLG);
    ShowObjWizardPages(NEXT); 
end;

//---------------------------------------------------------------------------
// OnSetTARGETDIR
//
// OnSetTARGETDIR is called directly by the framework to initialize
// TARGETDIR to it's default value.
//
// Note: This event is called for all setups.
//---------------------------------------------------------------------------
function OnSetTARGETDIR()
number nId, nIgnore, nResult;
string szId, szTARGETDIR;
begin

    // In maintenance mode the value of TARGETDIR is read from the log file.
    if( MAINTENANCE ) then
        return ISERR_SUCCESS;
    endif;

    // Set TARGETDIR to script default.
    TARGETDIR = "<FOLDER_APPLICATIONS>\\<IFX_COMPANY_NAME>\\<IFX_PRODUCT_NAME>";

    // Read TARGETDIR from the media.
    nResult = MediaGetData( MEDIA, MEDIA_FIELD_TARGETDIR, nIgnore, szTARGETDIR );

    // Use the TARGETDIR from the media if anything was read.
    if( nResult >= ISERR_SUCCESS && StrLengthChars( szTARGETDIR ) ) then
        TARGETDIR = szTARGETDIR;
    endif;
        
	// Customize the default TARGETDIR for multi-instance application.
	// TODO: If you want something different customize the code below.	
	if( MAINT_OPTION = MAINT_OPTION_MULTI_INSTANCE  && MULTI_INSTANCE_COUNT > 0) then

		// Start with the current multi-instance count plus one.
		nId = MULTI_INSTANCE_COUNT + 1;

		// Find a unique TARGETDIR.
		while( ExistsDir( TARGETDIR ) = EXISTS )
			
			// Convert to string.
			NumToStr( szId, nId );
			
			// Update IFX_MULTI_INSTANCE_SUFFIX
			IFX_MULTI_INSTANCE_SUFFIX = "_" + szId;
		
			// Update TARGETDIR
			TARGETDIR = TARGETDIR + IFX_MULTI_INSTANCE_SUFFIX;
			
			// Update nId
			nId = nId + 1;

		endwhile;

	endif;

end;

//---------------------------------------------------------------------------
// OnSetUpdateMode
//
// OnSetUpdateMode is called directly by the framework to set the UPDATEMODE
// InstallShield system variable appropriately to control which UI events
// are called by OnShowUI.
//
// Note: This event is called for all setups.
//---------------------------------------------------------------------------
function OnSetUpdateMode()
	number	nIgnore, nMediaFlags, nInstalledVersion, nUpdateVersion, nResult;
	string	szVersion, szIgnore, szMsg;
begin
	
	UPDATEMODE = FALSE; // Non-update mode by default.

	// Added 11.5 - Don't set UPDATEMODE when running from Add/Remove
	if( ADDREMOVE ) then
		return ISERR_SUCCESS;
	endif;

	// Added 11.5 - Don't set UPDATEMODE when REMOVEONLY is specified
	if( REMOVEONLY ) then
		return ISERR_SUCCESS;
	endif;

	// Get the media flags.
	MediaGetData( MEDIA, MEDIA_FIELD_MEDIA_FLAGS, nMediaFlags, szIgnore );

	// TODO: If you are updating an application that was installed by a previous
	// version of InstallShield, IFX_INSTALLED_VERSION will be empty, and
	// VERSION_COMPARE_RESULT_NOT_INSTALLED will be returned by
	// VerProductCompareVersions. Change the value of IFX_INSTALLED_VERSION (and
	// IFX_INSTALLED_DISPLAY_VERSION) here based on application specific version
	// information determined by the setup. Only do this if IFX_INSTALLED_VERSION
	// is empty.
	//if ( !StrLengthChars( IFX_INSTALLED_VERSION ) && MAINTENANCE ) then
	//	IFX_INSTALLED_VERSION = "X.XX.XXX";
	//	IFX_INSTALLED_DISPLAY_VERSION = IFX_INSTALLED_VERSION;
	//endif;

	// Verify that the installed version is valid.
	if( !StrLengthChars( IFX_INSTALLED_VERSION ) && MAINTENANCE ) then
		// If this error occurs, IFX_INSTALLED_VERSION needs to be set manually.
		szMsg = SdLoadString( IDS_IFX_ERROR_UPDATE_NO_INSTALLED_VERSION );
		MessageBox( szMsg, SEVERE );
		abort;
	endif;

	// Verify that the product version is valid.
	if( !StrLengthChars( IFX_PRODUCT_VERSION ) ) then
		// If this error occures, IFX_PRODUCT_VERSION was not initialized correctly.
		szMsg = SdLoadString( IDS_IFX_ERROR_UPDATE_NO_PRODUCT_VERSION );
		MessageBox( szMsg, SEVERE );
		abort;
	endif;

	// Do the version comparison.
	nResult = VerProductCompareVersions();

	// Make sure that valid data was returned by VerProductCompareVersions
	if( nResult < ISERR_SUCCESS ) then
		szMsg = SdLoadString( IDS_IFX_ERROR_UPDATE_VERSION_COMPARE_FAILURE );
		MessageBox( szMsg, SEVERE );
		abort;
	endif;

	// Set update mode if this is a differential media or the product is already installed and the versions do not match.
	UPDATEMODE = ( nMediaFlags & MEDIA_FLAG_FORMAT_DIFFERENTIAL || ( MAINTENANCE && ( nResult != VERSION_COMPARE_RESULT_SAME ) ) );

end;

//---------------------------------------------------------------------------
// OnCheckMediaPassword
//
// Displays a password dialog if the media is password protected.
//
// Note: This event is called for all setups.
//---------------------------------------------------------------------------
function OnCheckMediaPassword()
string szResult, szMsg;
BOOL bValidated;
begin

	// Check whether the setup author selected this option.
	if( !SHOW_PASSWORD_DIALOG ) then;
		return ISERR_SUCCESS;
	endif;

	// Check whether the password has been specified previously.
	LogReadCustomString( MEDIA_PASSWORD_KEY, szResult );
	if( FeatureValidate( MEDIA, "", szResult ) == 0 ) then
		return ISERR_SUCCESS;
	endif;

	// "Back" button should be disabled.
	Disable( BACKBUTTON );

	// Attempt to validate the media.
	bValidated = FALSE;

	// Loop until the password is validated.
	while( !bValidated )

		// Prompt for password.
		if( EnterPassword( "", "", szResult ) < ISERR_SUCCESS ) then
			abort; // Failed to display password dialog
		endif;

		// Attempt to validate the media.
		if( FeatureValidate( MEDIA, "", szResult ) == 0 ) then
			
			// Store the media password for maintenance mode.
			LogWriteCustomString( MEDIA_PASSWORD_KEY, szResult );

			bValidated = TRUE;
		else
			szMsg = SdLoadString( IDS_IFX_ERROR_INVALID_MEDIA_PASSWORD );
			MessageBox( szMsg, INFORMATION );
		endif;

	endwhile;

	// Enable "Back" button.
	Enable( BACKBUTTON );

end;

//---------------------------------------------------------------------------
// OnFilterComponents
//
// The OnFilterComponents event is called by the framework to filter out
// components in each feature by language and platform, override this
// event to perform custom filtering.
//
// Note: This event will not be called automatically in a
// program...endprogram style setup.
//---------------------------------------------------------------------------
function OnFilterComponents()
begin
    // Filter file groups by current platform.
    FeatureFilterOS(MEDIA, ISOS_ST_ALL, ISOSL_ALL, TRUE);
    FeatureFilterOS(MEDIA, SYSINFO.nSuites, SYSINFO.nISOSL, FALSE);
 
    // Filter file groups by current language.
    FeatureFilterLanguage(MEDIA, ISLANG_ALL, TRUE);
    FeatureFilterLanguage(MEDIA, STANDARD_SELECTED_LANGUAGE, FALSE);
end;

