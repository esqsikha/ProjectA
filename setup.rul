///////////////////////////////////////////////////////////////////////////////
//
//  FUNCTION:   OnMaintUIAfter
//
//  EVENT:      MaintUIAfter event is sent after file transfer, when end user runs 
//              installation that has already been installed on the machine. Usually 
//              this happens through Add/Remove Programs applet. 
//              In the handler installation usually displays UI that will inform 
//              end user that maintenance/uninstallation has been completed successfully.
//
///////////////////////////////////////////////////////////////////////////////
function OnMaintUIAfter()
    STRING szTitle, szMsg1, szMsg2, szOption1, szOption2,szJavaPath;
    NUMBER bOpt1, bOpt2;
    NUMBER nvReturn;
    //STRING szElinkdir;
begin    
     // szElinkdir=WINSYSDISK ^ "Documents and Settings" ^ "All Users" ^ "Application Data" ^ "ESQ" ^ "Elink";
     //For BE file move
    if bPakFile1=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile1,  TARGETDIR ^ "Back end" ^ svPakFile1 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile1,TARGETDIR ^ "Back end" ^ svPakFile1); 
    	endif;
    	nvReturn = FileCompare(svPackageloc  ^ svPakFile1,  TARGETDIR ^ "Back End" ^ svPakFile1 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPakFile1,TARGETDIR ^ "Back End" ^ svPakFile1); 
    	endif;
    endif; 
    
    if bPakFile2=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile2,  TARGETDIR ^ "Back end" ^ svPakFile2 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile2,TARGETDIR ^ "Back end" ^ svPakFile2); 
    	endif;
    	nvReturn = FileCompare(svPackageloc ^ svPakFile2,  TARGETDIR ^ "Back End" ^ svPakFile2 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPakFile2,TARGETDIR ^ "Back End" ^ svPakFile2); 
    	endif;
    endif; 
    
    if bPakFile3=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile3,  TARGETDIR ^ "Back end" ^ svPakFile3,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile3,TARGETDIR ^ "Back end" ^ svPakFile3); 
    	endif;
    	nvReturn = FileCompare(svPackageloc ^ svPakFile3,  TARGETDIR ^ "Back End" ^ svPakFile3 ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPakFile3,TARGETDIR ^ "Back End" ^ svPakFile3); 
    	endif;
    endif;
    
    //OCC web changes
    if bOCCWebFile=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile4, szAllUsersLoc ^ "Back End" ^ svPakFile4, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPackageFolderName ^ svPakFile4, szAllUsersLoc ^ "Back End" ^ svPakFile4); 
    	endif;  
    	
    	nvReturn = FileCompare(svPackageloc ^ svPakFile4,  szAllUsersLoc ^ "Back End" ^ svPakFile4, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPakFile4, szAllUsersLoc ^ "Back End" ^ svPakFile4); 
    	endif;
    endif;
    
    //RBAC web changes
    if bRBACWebFile=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile5, szAllUsersLoc ^ "Back End" ^ svPakFile5, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPackageFolderName ^ svPakFile5, szAllUsersLoc ^ "Back End" ^ svPakFile5); 
    	endif;  
    	
    	nvReturn = FileCompare(svPackageloc ^ svPakFile5,  szAllUsersLoc ^ "Back End" ^ svPakFile5, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPakFile5, szAllUsersLoc ^ "Back End" ^ svPakFile5); 
    	endif;
    endif;
    
    //for derbydb changes
    if bderbydb=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svderbydb,  TARGETDIR ^ "Back End" ^ svderbydb, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svPackageFolderName ^ svderbydb,TARGETDIR ^ "Back End" ^ svderbydb); 
    	endif;  
    	
    	nvReturn = FileCompare(svPackageloc ^ svderbydb,  TARGETDIR ^ "Back End" ^ svderbydb, COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc ^ svderbydb,TARGETDIR ^ "Back End" ^ svderbydb); 
    	endif;
    endif;
    
    if bReadMEFile=FALSE then
    
    else
    	nvReturn = FileCompare(svPackageloc  ^ svDocFolder ^ svReadMeFile,  TARGETDIR ^ "Back End" ^  svReadMeFile ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svDocFolder ^ svReadMeFile,TARGETDIR ^ "Back End" ^  svReadMeFile);
    		
    	endif;
    	
    	nvReturn = FileCompare(svPackageloc  ^ svReadMeFile,  TARGETDIR  ^ "Back End" ^  svReadMeFile ,COMPARE_DATE);
		if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svReadMeFile,TARGETDIR ^ "Back End" ^ svReadMeFile); 
    		
    	endif;
    	
    endif; 
    	//XCopyFile(TARGETDIR ^ "Elink" ^ "*.*", szElinkdir ^ "*.*", COMP_NORMAL);
    	
    	
		
    if bDocFile=FALSE then
    
    else
    		CopyFile(svPackageloc  ^ svDocFolder ^ svDocFile,TARGETDIR  ^ "Doc" ^ svDocFile); 
    		CopyFile(svPackageloc  ^ svDocFile ,TARGETDIR  ^ "Doc" ^ svDocFile);
    
   
    endif;  
      		
	Disable(STATUSDLG);
    ShowObjWizardPages(NEXT); 
    
end;
 
///////////////////////////////////////////////////////////////////////////////
//
//  FUNCTION:   OnFirstUIAfter
//
//  EVENT:      FirstUIAfter event is sent after file transfer, when installation 
//              is run for the first time on given machine. In this event handler 
//              installation usually displays UI that will inform end user that
//              installation has been completed successfully.
//
///////////////////////////////////////////////////////////////////////////////
function OnFirstUIAfter()
    STRING szTitle, szMsg1, szMsg2, szOption1, szOption2;
    NUMBER bOpt1, bOpt2;
    STRING szJavaOld,szJavaNew;
begin 
    //For BE file move 
    //szElinkpath=
    if bPakFile1=FALSE then
    
    else
    	//nvReturn = FileCompare(svPackageloc  ^ "BE" ^ "ovnmpak",  TARGETDIR ^ "Back End" ^ "ovnmpak" ,COMPARE_DATE);
		//if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile1,TARGETDIR ^ "Back end" ^ svPakFile1); 
    		CopyFile(svPackageloc  ^ svPakFile1,TARGETDIR ^ "Back End" ^ svPakFile1); 
    		
    	//endif;
    endif; 
    
    if bPakFile2=FALSE then
    
    else
    	//nvReturn = FileCompare(svPackageloc  ^ "BE" ^ "install",  TARGETDIR ^ "Back End" ^ "install" ,COMPARE_DATE);
		//if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile2,TARGETDIR ^ "Back end" ^ svPakFile2); 
    		CopyFile(svPackageloc  ^ svPakFile2 ,TARGETDIR ^ "Back End" ^ svPakFile2);
    		
    	//endif;
    endif;
     if bPakFile3=FALSE then
    
    else
    	
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile3,TARGETDIR ^ "Back end" ^ svPakFile3); 
    		CopyFile(svPackageloc  ^ svPakFile3 ,TARGETDIR ^ "Back End" ^ svPakFile3);
    		
    	//endif;
    endif;
    
     if bOCCWebFile=FALSE then
    
    else
    	//nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile2,  TARGETDIR ^ "Back End" ^ svPakFile2 ,COMPARE_DATE);
		//if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile4, szAllUsersLoc ^ "Back End" ^ svPakFile4); 
    		CopyFile(svPackageloc  ^ svPakFile4 , szAllUsersLoc ^ "Back End" ^ svPakFile4);
    	//endif;
    endif; 
    
    if bRBACWebFile=FALSE then
    
    else
    	//nvReturn = FileCompare(svPackageloc  ^ svPackageFolderName ^ svPakFile2,  TARGETDIR ^ "Back End" ^ svPakFile2 ,COMPARE_DATE);
		//if(!(nvReturn = EQUALS || nvReturn = LESS_THAN) ) then
    		CopyFile(svPackageloc  ^ svPackageFolderName ^ svPakFile5, szAllUsersLoc ^ "Back End" ^ svPakFile5); 
    		CopyFile(svPackageloc  ^ svPakFile5 , szAllUsersLoc ^ "Back End" ^ svPakFile5);
    	//endif;
    endif;
    
    // for derbydb changes
     if bderbydb=FALSE then
    
     else
    	CopyFile(svPackageloc  ^ svPackageFolderName ^ svderbydb,TARGETDIR ^ "Back End" ^ svderbydb); 
    	CopyFile(svPackageloc  ^ svderbydb , TARGETDIR ^ "Back End" ^ svderbydb);
    	
     endif;
      
     //For Docs move
    if bReadMEFile=FALSE then
    
    else
    		CopyFile(svPackageloc  ^ svDocFolder ^ svReadMeFile,TARGETDIR ^ "Back End" ^  svReadMeFile);
    		CopyFile(svPackageloc  ^ svReadMeFile,TARGETDIR ^ "Back End" ^ svReadMeFile); 
    		
    endif;
    	
    	
    
    
    if bDocFile=FALSE then
    
    else
    		CopyFile(svPackageloc  ^ svDocFolder ^ svDocFile,TARGETDIR  ^ "Doc" ^ svDocFile); 
    		CopyFile(svPackageloc  ^ svDocFile ,TARGETDIR  ^ "Doc" ^ svDocFile);
    
    		//nreturn=CopyFile(svPackageloc  ^ "OVNM User and Installation Guide.pdf" ,TARGETDIR  ^ "Doc" ^ "OVNM User and Installation Guide.pdf");
    		//nreturn=CopyFile(svPackageloc  ^  svDocFolder ^ "OVNM User and Installation Guide.pdf" ,TARGETDIR  ^ "Doc" ^ "OVNM User and Installation Guide.pdf"); 
    endif; 
    
   szJavaOld= TARGETDIR ^ "Back End" ^ "Java16"; 
   szJavaNew= TARGETDIR ^ "Back End" ^ "Java";
   RenameFile(szJavaOld,szJavaNew);
   //szUpdateMsg ="Copying JRE 1.6 version files.";
	//SdShowMsg (szUpdateMsg, TRUE);
    //   XCopyFile ( svPackageloc ^ "Java" ^"*.*",TARGETDIR ^ "Back End" ^ "Java" ^ "*.*",INCLUDE_SUBDIR);
    	 	
    
   
   SdShowMsg (szUpdateMsg, FALSE);	
   Disable(STATUSDLG);
   ShowObjWizardPages(NEXT); 
end;
                              
function CreateAODBDSN() 
NUMBER nResult;
begin
	RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE);
    //Creating AOReporter DSN
    RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "" );
    RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "DBQ");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "DBQ", REGDB_STRING, TARGETDIR + "\\AO\\AODB.MDB", -1 );
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "Description");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "Description", REGDB_STRING, "OpenNET/AO Data Base", -1 );
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "Driver");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "Driver", REGDB_STRING, WINSYSDIR ^ "odbcjt32.dll", -1 );
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "DriverId");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "DriverId", REGDB_NUMBER, "25", -1 );
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "FIL");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "FIL", REGDB_STRING, "MS Access;", -1 );
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "Safe Transactions");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "Safe Transactions", REGDB_NUMBER, "0", -1 );
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "UID");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB", "UID",REGDB_STRING, "", -1 );
	
    RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines", "" );
    RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines\\Jet", "" );
    
    RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines\\Jet", "ImplicitCommitSync");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines\\Jet", "ImplicitCommitSync", REGDB_STRING, "", -1 );
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines\\Jet", "PageTimeout");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines\\Jet", "PageTimeout", REGDB_NUMBER, "5", -1 );
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines\\Jet", "Threads");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines\\Jet", "Threads", REGDB_NUMBER, "3", -1 );
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines\\Jet", "UserCommitSync");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\AODB\\Engines\\Jet", "UserCommitSync", REGDB_STRING, "Yes", -1 );
	
	RegDBCreateKeyEx  ( "SOFTWARE\\ODBC\\ODBC.INI\\ODBC Data Sources", "AODB");
	RegDBSetKeyValueEx( "SOFTWARE\\ODBC\\ODBC.INI\\ODBC Data Sources", "AODB", REGDB_STRING, "Microsoft Access Driver (*.mdb)", -1 );
	
end;                          


function SetupRegistry()
STRING szStartRunKey, szStartupElink, szStartupMail, szStartupPage;
 begin
	 // TODO : Add all your registry entry keys here   
	 if (FeatureIsItemSelected(MEDIA, "AO 2.0\\AO Configuration Client") && bConfig = FALSE) then
	 	bConfig = TRUE; 
	 	RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);  
	 	RegDBCreateKeyEx  ( "Software\\ESQ\\AO", "MailServer");
		RegDBSetKeyValueEx( "Software\\ESQ\\AO", "MailServer", REGDB_STRING, svMailServerName, -1 );
		RegDBCreateKeyEx  ( "Software\\ESQ\\AO", "MailFrom");
		RegDBSetKeyValueEx( "Software\\ESQ\\AO", "MailFrom", REGDB_STRING, svMailID, -1 );    
		RegDBCreateKeyEx  ( "Software\\ESQ\\AO", "PagerFlag");
		RegDBSetKeyValueEx( "Software\\ESQ\\AO", "PagerFlag", REGDB_NUMBER, "1", -1 );    
		        
		RegDBSetDefaultRoot(HKEY_CURRENT_USER);  		        
		RegDBCreateKeyEx  ( "Software\\ESQ\\AO\\Config", "ConfigCount");
		RegDBSetKeyValueEx( "Software\\ESQ\\AO\\Config", "ConfigCount", REGDB_NUMBER, "0", -1 );
     endif;  
     if (FeatureIsItemSelected(MEDIA, "OV Nonstop Mnager\\Elink Manager") && bElink = FALSE) then
	 	bElink = TRUE;
	 	RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);   
	 	RegDBCreateKeyEx("Software\\ESQ\\Elink", "RemotePort");
	    RegDBSetKeyValueEx( "Software\\ESQ\\Elink", "RemotePort", REGDB_NUMBER, svRemotePort, -1 );
		RegDBCreateKeyEx("Software\\ESQ\\AO", "RemotePort");	    
	    RegDBSetKeyValueEx( "Software\\ESQ\\AO", "RemotePort", REGDB_NUMBER, svRemotePort, -1 );
	    RegDBCreateKeyEx("Software\\ESQ\\AO", "NodeCount");
	    RegDBSetKeyValueEx( "Software\\ESQ\\AO", "NodeCount", REGDB_NUMBER, "0", -1 );

	    RegDBSetDefaultRoot(HKEY_CURRENT_USER);         
        RegDBSetKeyValueEx( "Software\\ESQ\\AO", "", REGDB_STRING, "AO Settings", -1 );
        RegDBCreateKeyEx("Software\\ESQ\\AO", "RemotePort");
        RegDBSetKeyValueEx( "Software\\ESQ\\AO", "RemotePort", REGDB_NUMBER, svRemotePort, -1 );
    	RegDBCreateKeyEx  ( "Software\\ESQ\\AO\\AOLIVE", "RemotePort");
        RegDBSetKeyValueEx( "Software\\ESQ\\AO\\AOLIVE", "RemotePort", REGDB_NUMBER, svRemotePort, -1 );
    
	    RegDBCreateKeyEx("Software\\ESQ\\AO", "NodeCount"); 
	    RegDBCreateKeyEx("Software\\ESQ\\AO\\Config", "ConfigCount");
	    RegDBSetKeyValueEx("Software\\ESQ\\AO\\Config", "ConfigCount", REGDB_NUMBER, "0", -1);      	
       	RegDBSetKeyValueEx( "Software\\ESQ\\AO", "NodeCount", REGDB_NUMBER, "0", -1 );
	endif;
end;    


function RemoveReporterSchedulerClass ()     
STRING  strClsid;
NUMBER  nvSize, nvType;
begin         
	RegDBSetDefaultRoot (HKEY_LOCAL_MACHINE);  
    if(RegDBGetKeyValueEx ("Software\\Classes\\Scheduler.ClsScheduleMain","Clsid", nvType, strClsid, nvSize) = 0) then
		RegDBDeleteKey("Software\\Classes\\Scheduler.ClsScheduleMain");
		RegDBSetDefaultRoot (HKEY_CLASSES_ROOT);
		RegDBDeleteKey("Clsid" ^  strClsid);			    	
    endif;
end;

