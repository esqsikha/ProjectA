   	DeleteDir(TARGETDIR ^ "Back End" ^ "Java" ^ "Etc",ONLYDIR);
   	DeleteDir(TARGETDIR ^ "Back End" ^ "Java" ^ "Europe",ONLYDIR);
   	DeleteDir(TARGETDIR ^ "Back End" ^ "Java" ^ "ff",ALLCONTENTS);
   	DeleteDir(TARGETDIR ^ "Back End" ^ "Java" ^ "ff",ONLYDIR);
