///////////////////////////////////////////////////////////////////////////////
//
//  FUNCTION:   DeleteJavaRunTimeOlderVersion
//
//  To Delete Older Java run time <1.4.2_03 installed by Only AO 3.3
//
///////////////////////////////////////////////////////////////////////////////

function DeleteJavaRunTimeOlderVersion()
STRING szPath,strJavaPath;
NUMBER nvType,nvSize;
begin
	if RegDBKeyExist("Software\\JavaSoft\\Java Runtime Environment\\1.4.2")=1 then 
			RegDBGetKeyValueEx ("Software\\JavaSoft\\Java Runtime Environment\\1.4.2","JavaHome", nvType, strJavaPath, nvSize);
			StrSub(szPath,strJavaPath,0,StrLength(strJavaPath)-StrLength("\\AOJRE"));
			if StrCompare(TARGETDIR,szPath)=0 then
				RegDBDeleteKey("Software\\JavaSoft\\Java Runtime Environment\\1.4.2");
			endif; 
	endif;
	
	if RegDBKeyExist("Software\\JavaSoft\\Java Plug-in\\1.4.2")=1 then
			RegDBGetKeyValueEx ("Software\\JavaSoft\\Java Plug-in\\1.4.2","JavaHome", nvType, strJavaPath, nvSize);
			StrSub(szPath,strJavaPath,0,StrLength(strJavaPath)-StrLength("\\AOJRE"));
			if StrCompare(TARGETDIR,szPath)=0 then
				RegDBDeleteKey("Software\\JavaSoft\\Java Plug-in\\1.4.2");
			endif; 
	endif;
	
	if RegDBKeyExist("Software\\JavaSoft\\Java Runtime Environment\\1.4")=1 then 
			RegDBGetKeyValueEx ("Software\\JavaSoft\\Java Runtime Environment\\1.4","JavaHome", nvType, strJavaPath, nvSize);
			StrSub(szPath,strJavaPath,0,StrLength(strJavaPath)-StrLength("\\AOJRE"));
			if StrCompare(TARGETDIR,szPath)=0 then
				RegDBDeleteKey("Software\\JavaSoft\\Java Runtime Environment\\1.4");
			endif; 
	endif;
	
	if ExistsDir(TARGETDIR ^ "AOJRE")=0 then
		SetFileInfo ( TARGETDIR ^ "AOJRE" ^ "LICENSE", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
		SetFileInfo ( TARGETDIR ^ "AOJRE" ^ "LICENSE_fr.rtf", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
		SetFileInfo ( TARGETDIR ^ "AOJRE" ^ "LICENSE_zh_CN.rtf", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
		SetFileInfo ( TARGETDIR ^ "AOJRE" ^ "LICENSE_zh_TW.rtf", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
		DeleteDir(TARGETDIR ^ "AOJRE",ALLCONTENTS);	
	endif; 
end;                              
 
//////////////////////////////////////////////////////////////////////////////
//  VisionChecking:  To add Vision link in console     
////////////////////////////////////////////////////////////////////////////////

function VisionLink()
STRING   szPath,szCmd, szProgramFolder;  
NUMBER  nvType, nvSize;
NUMBER nResult;
STRING  szProgramFolderList,nTim,svLine;
STRING szProgram,szCmdLine,svValue,szFileName,szBuffer,fResult;
NUMBER nvFileHandle1;
BOOL   bTimWebLink;
begin
       bTimWebLink=FALSE;
       // Check for Vision
        RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
        if (RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{765B9A42-44A3-11D7-A9B4-008048B7B06E}", "DisplayName", nvType, svValue, nvSize) == 0) then
	        RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{765B9A42-44A3-11D7-A9B4-008048B7B06E}", "InstallLocation", nvType, svValue, nvSize);
	        if (ExistsDir(svValue ^ "Nodes")=0) then
	        	SetDialogTitle ( DLG_ASK_YESNO, "OpenNET/AO");
	        	if(AskYesNo ("Do You want to add link for OpenNET/Vision to the Console?", YES) = YES) then
	 				szProgram=SUPPORTDIR ^ "SITEINI.EXE";
		        	szCmdLine= "\"" + TARGETDIR ^ "Console" ^ "console.conf" + "\"";
		        	LaunchAppAndWait (szProgram, "\"" + svValue ^ "Nodes" + "\" " + szCmdLine, WAIT);
		        	if FindFile(TARGETDIR ^ "Console" ,"console.conf",fResult)=0 then 
		        		 nTim="otc         { cmd-name = \"AddLink\", link-name = \"TIM\", link-url = \"http://h30163.www3.hp.com/legal.asp?redirect_page=/Default.asp\" }";
		        		 OpenFileMode(FILE_MODE_APPEND);
		        		 szPath = TARGETDIR ^ "Console";
		        		 OpenFile(nvFileHandle1,szPath,"console.conf");
		        		 while(GetLine(nvFileHandle1,svLine)==0)
		        		 	if StrFind(svLine,nTim)=0 then
		        		 		bTimWebLink=TRUE;
		        		    else
		        		    	bTimWebLink=FALSE;		
		        		 	endif;
		        		 endwhile;
		        		 if  bTimWebLink=FALSE then
		        		 	WriteLine(nvFileHandle1, "otc         { cmd-name = \"AddLink\", link-name = \"TIM\", link-url = \"http://h30163.www3.hp.com/legal.asp?redirect_page=/Default.asp\" }");
		        		 endif;
		        		 CloseFile(nvFileHandle1);
		        	else   
		        	
		        		szPath = TARGETDIR ^ "Console";
						szFileName = "console.conf";
						OpenFileMode(FILE_MODE_BINARY);
						CreateFile (nvFileHandle1, szPath, szFileName);
		        		szBuffer="setotckey     { value = \"OTCK-Console-1344\" }\r\n" +
		        		 "otc         { cmd-name = \"AddLink\", link-name = \"HP NonStop PERFORMANCE\", link-url = \"http://HPNSK:5001/TDB?NODE=HPNSK&TDBID=0:all\"}\r\n" +
		        		 "otc         { cmd-name = \"AddLink\", link-name = \"TIM\", link-url = \"http://h30163.www3.hp.com/legal.asp?redirect_page=/Default.asp\" }\r\n\r\n";
		        		WriteBytes ( nvFileHandle1, szBuffer, 0, StrLength(szBuffer));
		        		CloseFile(nvFileHandle1);
		        	endif;
	        	endif;
	        endif;
        endif;
        // end changes for Vision
end;

