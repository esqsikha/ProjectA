	        SERVICE_IS_PARAMS.lpServiceStartName=NULL;
			SERVICE_IS_PARAMS.lpPassword=NULL;
			szProgram =  TARGETDIR ^"Elink" ^"elinkService.exe";
			LongPathToQuote( szProgram, TRUE);
