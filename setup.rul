    //endif;
Dlg_SdStartCopy:
    szTitle = "Check Setup Information.";
    szMsg   = "Setup has enough information to begin the file-transfer\n" +
              "operation. If you are satisfied with the settings,\n" +
              "click Next to begin copying files.";
    listStartCopy = ListCreate( STRINGLIST );
    //The following is an example of how to add a string(svName) to a list(listStartCopy).
    //eg. ListAddString(listStartCopy,svName,AFTER); 
  	
	  	/*if FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter")=TRUE then
		  	if FindFile(szReporterDSNPath ^ "Reporter","AONEWDB.MDB",nDBname) <0 then
			    bReporterDatabase=FALSE;
			    ListAddString(listStartCopy, "Scheduler Information:", AFTER);
			    ListAddString(listStartCopy, "          " +"Database does not Exist. Scheduler Feature will be enabled", AFTER);
				ListAddString(listStartCopy, "", AFTER);
				
			else
				bReporterDatabase=TRUE;
				ListAddString(listStartCopy, "Scheduler Information:", AFTER);
				ListAddString(listStartCopy, "          "  + "Database already Exist. Scheduler Feature will be disabled", AFTER);
				ListAddString(listStartCopy, "", AFTER);			
			endif;
	  	endif;*/
  	//ListAddString(listStartCopy, "User Information: ", AFTER);
  	//ListAddString(listStartCopy, "          " + svName, AFTER);
  	//ListAddString(listStartCopy, "          " + svCompany, AFTER);
  	//ListAddString(listStartCopy, "", AFTER);
  	ListAddString(listStartCopy, "Destination Directory:", AFTER);
  	ListAddString(listStartCopy, "           " + TARGETDIR, AFTER);
  	ListAddString(listStartCopy, "", AFTER);
  	/*if FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter")=TRUE then
	  	//ListAddString(listStartCopy, "OpenNET/Reporter Destination Directory:", AFTER);
	  	//ListAddString(listStartCopy, "           " + szDir ^"Reporter", AFTER);
	  	//ListAddString(listStartCopy, "", AFTER);
	  	ListAddString(listStartCopy, "OpenNET/Reporter Database Directory:", AFTER);
	  	ListAddString(listStartCopy, "           " + szReporterDSNPath ^"Reporter", AFTER);
  		ListAddString(listStartCopy, "", AFTER);
  	endif;*/
  	
  	
    nResult = SdStartCopy( szTitle, szMsg, listStartCopy );	
    ListDestroy(listStartCopy);
    if (nResult = BACK) goto Dlg_ObjDialogs;
    //if FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter")=TRUE then
    //	FeatureSetTarget (MEDIA, "<szReporterDSNPath>", szReporterDSNPath );
    //endif;
     // setup default status 
 	SetStatusWindow(0, "");
	PlaceWindow (STATUSDLG, (30*nvDx)/1024,(30*nvDy)/300, LOWER_RIGHT);
	Enable(STATUSDLG); 
	SetStatusExStaticText( "Please wait while the Wizard is configuring " + IFX_PRODUCT_NAME+" installation process." );  			
	StatusUpdate(ON, 100);
    RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE); 
    //RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "CompanyName");
	//RegDBSetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "CompanyName", REGDB_STRING, svCompany, -1 );
	//RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "UserName");
	//RegDBSetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "UserName", REGDB_STRING, svName, -1 );
   return 0;
end;

///////////////////////////////////////////////////////////////////////////////
//
//  FUNCTION:   OnMoving
//
//  EVENT:      Moving event is sent when file transfer is started as a result of
//              ComponentTransferData call, before any file transfer operations 
//              are performed.
//
///////////////////////////////////////////////////////////////////////////////
function OnMoving()
    STRING  svInfo; 
    NUMBER nResult, nvInfo;
begin
    // Set LOGO Compliance Application Path 
    // TO DO : if your application .exe is in a subfolder of TARGETDIR then add subfolder 
    szAppPath = TARGETDIR;
    RegDBSetItem(REGDB_APPPATH, szAppPath);
    RegDBSetItem(REGDB_APPPATH_DEFAULT, szAppPath ^ IFX_PRODUCT_KEY);
end;
  

function DialogShowSdFinishReboot()
    STRING szTitle, szMsg1, szMsg2, szOption1, szOption2, szCmd;
    NUMBER bOpt1, bOpt2;
begin
	bOpt1  = FALSE;
    bOpt2  = FALSE;   
    szMsg1 = "Setup has finished installing " + szProduct +
               " on your computer. "+
               "You can start the application from Windows Start->";
	if(FeatureIsItemSelected(MEDIA, "AO 2.0\\AO Configuration Client")) then
		szMsg1 = szMsg1 + "All Programs->OpenNET->AO->AO Configuration Client.\n\n";
	else 
		szMsg1 = szMsg1 + "All Programs->OpenNET\n\n";
	endif;      	
      
    //if(!MAINTENANCE) then
    	//szMsg2 = "For Installing HP NonStop Server Components use\nStart->Programs->OpenNET->AO->Host Installation Client.";
    	//szOption1 = "";
	//else
	bOpt1 = TRUE;
	szOption1 = "Open Readme file";   	
	szMsg2 = "If you don't read Readme file now, please use\nStart->All Programs->OpenNET->AO->Documents->Readme to read it later.";
	//endif;       
	szOption2 = "";
	szTitle = szProduct +" Setup Completed";   	
    SdFinish(szTitle, szMsg1, szMsg2, szOption1, szOption2, bOpt1, bOpt2);
    if (bOpt1 = TRUE) then
		if bReadMEFile = TRUE then 
			szCmd =  TARGETDIR ^ "Back end" ^ "Readme.txt" ;
			LongPathToQuote( szCmd, TRUE);
			LaunchAppAndWait  ("notepad.exe", szCmd, NOWAIT); 	
			
		endif;
	
    endif;
    
    
end;             
  
///////////////////////////////////////////////////////////////////////////////
//
//  FUNCTION:   OnEnd
//
//  EVENT:      End event is the last event. It is not sent if the installation
//              has been aborted. In this case Abort event is sent
//
///////////////////////////////////////////////////////////////////////////////
function OnEnd() 
	STRING   szPath,szCmd, szProgramFolder,nConsoleResult,sResult;  
	STRING szMessage, svUninstallString, svResult,strJavaVersion,strJavaHome;
	NUMBER nvType, nvSize, nResult,nReturn;
	LIST    listItemsID, listFoldersID;
	STRING szStartRunKey,szStartupNSK;
	STRING szDLLName;
	STRING svTargetValue,svValue, szTitle, szMsg; 
	STRING szProgram,szCmdLine;
	STRING szJavaOld,szJavaNew,szJavaPath;
	STRING szDuplicationbatchPath;
	STRING szExistedKey,szexisteddeleteValue,szOccReg;
	STRING svOCCTokenPath;
	STRING  szStartupMail, szStartupPage, szStartupElink,sFileName;
begin  
	SdShowMsg (szUpdateMsg, FALSE);	
	Disable(STATUSDLG);
    RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
	szStartRunKey  =  "Software\\Microsoft\\Windows\\CurrentVersion\\Run";
	//szPath          = WINDIR ^ "AOSetup.exe";
	//LongPathToQuote( szPath, TRUE );
	//szStartupNSK   = szPath;
	/* Create the run key... */
