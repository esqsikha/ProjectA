//////////////////////////////////////////////////////////////////////////////
//
//  FUNCTION:   OnCanceling
//
//  EVENT:      Canceling event is sent when installation is being canceled,
//              usually as result of end user clicking Cancel button or pressing
//              Esc key. Execution of Do(EXIT) will also trigger this event.
//
///////////////////////////////////////////////////////////////////////////////
function OnCanceling()  
STRING svMessage;
begin     
	/*Change by Sachin on 10th Dec,2004*/ 
	/*Due to Spell Mistake*/
	svMessage =  "Setup is not complete. If you quit the setup program now, "
				+ "the components you requested to add/remove will not be installed/uninstalled."
				+ " Are you sure you want to quit the setup?";
    if (SprintfBox(MB_YESNO|MB_ICONEXCLAMATION|MB_DEFBUTTON2, 
                           SdLoadString(SD_STR_ONCANCELING_TITLE), 
                           svMessage) = IDYES ) then
		Disable(STATUSDLG);
	  	Disable( FULLWINDOWMODE );						   
      	Disable( BACKGROUND );                                
      	abort;
    endif;
end;
                              
///////////////////////////////////////////////////////////////////////////////
//  EVENT:      Installed event is sent just after files for the component: 
//              InstallShield Components are transferred. 
///////////////////////////////////////////////////////////////////////////////
 
export prototype InstallShieldComponents_Installed();
function InstallShieldComponents_Installed()
OBJECT oObj;
NUMBER nStatusNumber;
STRING szAttributes, szDriverName, szAttribs, szDSNType, szName;
begin  
    Disable(STATUSDLG);
	szUpdateMsg = "Updating system settings. Please wait...";
    SdShowMsg (szUpdateMsg, TRUE);
	set oObj = GetObject("ODBC 3.51");	
	if IsObject(oObj) then   
		/* Install SQL Driver */
		szAttributes = "Driver=" + WINSYSDIR + "odbcjt32.dll\n" +
						"Setup=" + WINSYSDIR +"odbcjt32.dll\n" +
						"APILevel=1\n" +
                        "ConnectFunctions=YYN\n" +
                        "DriverODBCVer=03.50\n" +
                        "FileUsage=2\n" +
                        "SQLLevel=0 \n" ;      
		szDriverName = "MicroSoft Access Driver (*.mdb)";                        
		nStatusNumber = oObj.InstallDriver ( szAttributes, szDriverName ); 
		Delay(1);
	endif;
	//MDacInstall();
	return 0;
end;                          



