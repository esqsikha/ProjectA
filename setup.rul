function Datafilesmoving() 
//STRING szElinkpath32,szElinkpath64;
begin 
	szUpdateMsg = "Moving configuration files to All Users location. Please wait..";  
	SdShowMsg (szUpdateMsg, TRUE);
 	XCopyFile(TARGETDIR ^ "Back End" ^ "help" ^ "*.*", szAllUsersLoc ^ "Back End" ^ "help", INCLUDE_SUBDIR);
	CopyFile(TARGETDIR  ^ "Back End" ^ "AOPAK", szAllUsersLoc ^ "Back End" ^ "AOPAK"); 
	CopyFile(TARGETDIR ^ "Back End" ^ "AOTIME", szAllUsersLoc ^ "Back End" ^ "AOTIME");
	CopyFile(TARGETDIR ^ "Back End" ^ "ztready", szAllUsersLoc ^ "Back End" ^ "ztready");
	CopyFile(TARGETDIR ^ "Back End" ^ "checkpak", szAllUsersLoc ^ "Back End" ^ "checkpak");
	CopyFile(TARGETDIR ^ "Back End" ^ "INSTALL", szAllUsersLoc ^ "Back End" ^ "INSTALL");
	CopyFile(TARGETDIR ^ "Back End" ^ "InstInfo", szAllUsersLoc ^ "Back End" ^ "InstInfo"); 
	CopyFile(TARGETDIR ^ "Back End" ^ "nodeinfo", szAllUsersLoc ^ "Back End" ^ "nodeinfo");
	CopyFile(svPackageloc ^ "BE" ^ "nodeinfo", szAllUsersLoc ^ "Back End" ^ "nodeinfo");
	//CopyFile(svPackageloc ^ svPackageFolderName ^ svPakFile4, szAllUsersLoc ^ "Back End" ^ svPakFile4);
	//CopyFile(svPackageloc ^ svPackageFolderName ^ svPakFile5, szAllUsersLoc ^ "Back End" ^ svPakFile5);
	//CopyFile(svPackageloc ^ svPackageFolderName ^ svderbydb, szAllUsersLoc ^ "Back End" ^ svderbydb);
	
	CopyFile(TARGETDIR ^ "Elink" ^ "ElinkMgr.cnt", szAllUsersLoc ^ "Elink" ^ "ElinkMgr.cnt"); 
	XCopyFile(TARGETDIR ^ "Back End" ^ "*InstInfo", szAllUsersLoc ^ "Back End", COMP_NORMAL);
	XCopyFile(TARGETDIR ^ "Back End" ^ "Certs" ^ "*.*", szAllUsersLoc ^ "Back End" ^ "Certs", INCLUDE_SUBDIR);
	//XCopyFile(TARGETDIR ^ "Back End" ^ "*.txt", szAllUsersLoc ^ "Back End", COMP_NORMAL);
	
	XCopyFile(TARGETDIR ^ "Elink" ^ "*.log", szAllUsersLoc ^ "Elink", COMP_NORMAL);
	XCopyFile(TARGETDIR ^ "Elink" ^ "*.cfg", szAllUsersLoc ^ "Elink", COMP_NORMAL);
 	Delay(5); 
 	
 	if Is(FILE_EXISTS,szAllUsersLoc ^ "Back End" ^ "AOPAK") then
 		DeleteFile(TARGETDIR ^ "Back End" ^ "AOPAK");
 	endif;
 	
 	if Is(FILE_EXISTS,szAllUsersLoc ^ "Back End" ^ "AOTIME") then
 		DeleteFile(TARGETDIR ^ "Back End" ^ "AOTIME");
 	endif;
 	if Is(FILE_EXISTS,szAllUsersLoc ^ "Back End" ^ "ztready") then
 		DeleteFile(TARGETDIR ^ "Back End" ^ "ztready");
 	endif;
 	if Is(FILE_EXISTS,szAllUsersLoc ^ "Back End" ^ "checkpak") then
 		DeleteFile(TARGETDIR ^ "Back End" ^ "checkpak");
 	endif;
 	if Is(FILE_EXISTS,szAllUsersLoc ^ "Back End" ^ "INSTALL") then
 		DeleteFile(TARGETDIR ^ "Back End" ^ "INSTALL");
 	endif;
 	if Is(FILE_EXISTS,szAllUsersLoc ^ "Back End" ^ "InstInfo") then
 		DeleteFile(TARGETDIR ^ "Back End" ^ "InstInfo");
 	endif;
 	
 	//DeleteFile(TARGETDIR ^ "Elink" ^ "elink.cfg");
 	if Is(FILE_EXISTS,szAllUsersLoc ^ "Elink" ^ "ElinkMgr.cnt") then
 		DeleteFile(TARGETDIR ^ "Elink" ^ "ElinkMgr.cnt");
 	endif;   
 	if Is(FILE_EXISTS,szAllUsersLoc ^ "Elink" ^ "Elink.log") then
 		DeleteFile(TARGETDIR ^ "Elink" ^ "*.log");
 	endif;
 	if (ExistsDir (szAllUsersLoc ^ "Back End" ^ "help") = EXISTS) then 
 		DeleteDir(TARGETDIR ^ "Back End" ^ "help", ALLCONTENTS);
 		DeleteDir(TARGETDIR ^ "Back End" ^ "help", ONLYDIR);
 	endif; 
 	if Is(FILE_EXISTS,szAllUsersLoc ^ "Elink" ^ "elink.cfg") then  
 		DeleteFile(TARGETDIR ^ "Elink" ^ "elink_backup.cfg");
 		RenameFile(TARGETDIR ^ "Elink" ^ "elink.cfg", TARGETDIR ^ "Elink" ^ "elink_backup.cfg");
 	endif;
 	//Certs
 	if (ExistsDir (szAllUsersLoc ^ "Back End" ^ "Certs") = EXISTS) then 
 		DeleteDir(TARGETDIR ^ "Back End" ^ "Certs", ALLCONTENTS); 		
 	endif;
 	
 	SdShowMsg (szUpdateMsg, FALSE); 	
 	
end;

