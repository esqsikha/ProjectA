//////////////////////////////////////////////////////////////////////////////
//                                                                           
//  FUNCTION:   OnFirstUIBefore                                            
//                                                                           
//  EVENT:      FirstUIBefore event is sent when installation is run for the first
//              time on given machine. In the handler installation usually displays
//              UI allowing end user to specify installation parameters. After this
//              function returns, ComponentTransferData is called to perform file
//              transfer.
//                                                                           
///////////////////////////////////////////////////////////////////////////////
 function OnBegin()  
 NUMBER nvType, nvSize;
 STRING svUninstallString, szAOPath,svValue,nDBname,svTargetStr;
 STRING szDLLName;
 STRING svOldVisionReporterValue;
 STRING szJavaPath;
 //For BE files
 STRING svovnmPakfile,tempsvPackageloc;
 begin  
 	bRemoveLogger=FALSE;
 	bLoggerInstall=FALSE;
 	bElink = FALSE; 
 	bOldElink = FALSE;  
 	bConfig = FALSE;
 	bOlderVersion = FALSE; 
 	MaintenaceFlag = FALSE;   
 	svOldProduct = ""; 
 	svRemotePort = "8976"; 
 	svName    = "";
    svCompany = "";
 	Enable (LOGGING);
 	bReporterScheduler=FALSE;
 	bObjMapInstallation=FALSE;
 	bConsoleInstallation=FALSE;
 	bReporterInstallation=FALSE;
 	bVisionInstallation=FALSE;
 	bOldVisionReporterAgent=FALSE;
 	bSNMPAdapter=FALSE;
 	bOVNMTadapterInstallation=FALSE;
 	bOVAdapter=FALSE;
 	bOVNPMDisplayInstallation=FALSE;
 	bOVNPMReporterInstallation=FALSE;
 	bOVNPMPluginInstallation= FALSE; 
 	bPreviousElinkInstall=FALSE;
 	bOCCWebFile=FALSE;
 	bRBACWebFile=FALSE;
 	bderbydb=FALSE;
 	sSQLUserName = "sa";
    sDBName = "LoggerDB"; 
  	sDBPwd = "";
  	bEventLogger=FALSE;
  	bUpgrade=FALSE;
  	b64bitOS=FALSE;
    bWinNT=FALSE;
    bWinServer2003=FALSE; 
    bvAllUsers=FALSE;
 	//Enable (DIALOGCACHE); 
 	RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
 	RegDBGetItem (REGDB_UNINSTALL_NAME, svOldProduct);    
 	GetExtents(nvDx,nvDy); 
 	//For BE files
 	svPackageName= "\\AO60_Installation.exe"; 
    svPakFile1="AOPAK";
    svPakFile2="INSTALL";   
    svPakFile3="AOTIME";
    svPackageFolderName="BE";
    svPakFile4="occ-esq.jar"; 
    svPakFile5="rbac-default.jar";
    svderbydb="*.tar";
     
     //For Windows 64 bit
     //if SYSINFO.bIsWow64 != 0 then
			//MessageBox("Windows 64 bit", INFORMATION);
			//REGDB_OPTIONS = REGDB_OPTIONS | REGDB_OPTION_WOW64_64KEY; 
	//else
			//REGDB_OPTIONS = REGDB_OPTIONS & ~REGDB_OPTION_WOW64_64KEY;
			//REGDB_OPTIONS=REGDB_OPTION_USE_DEFAULT_OPTIONS; 
	//endif; 
	//5.3 changes
	
	if SYSINFO.bIsWow64  != 0 then	   
	 	 b64bitOS=TRUE;
	 else
	     b64bitOS=FALSE;	    
	 endif; 
	 if SYSINFO.WINNT.bWinNT != 0 ||   SYSINFO.WINNT.bWinServer2003 !=0 then
	    bWinNT=TRUE;
    	bWinServer2003=TRUE; 
    	
     else
     	bWinNT=FALSE;
    	bWinServer2003=FALSE; 
    	
    endif;
    RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
   	RegDBGetKeyValueEx("Software\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList","ProfilesDirectory", nvType, svSysdir, nvSize);
     
	StrFind(svSysdir,"%SystemDrive%");
	GetDisk(WINSYSDIR,szDrive);
	StrReplace ( svSysdir, "%SystemDrive%", szDrive, 0 ); 	

	if (SYSINFO.WINNT.bWinXP) || (SYSINFO.WINNT.bWin2000) ||  (SYSINFO.WINNT.bWinServer2003) then
		bALLUsersXP = TRUE;
		szAllUsersLoc =  svSysdir ^ "All Users" ^ "Application Data" ^ "ESQ" ^ "OpenNET";
	else
		bALLUsersXP = FALSE;
		szAllUsersLoc =  svSysdir ^ "All Users" ^ "ESQ" ^ "OpenNET";
	endif;


	szElinkpath32 = szAllUsersLoc ^ "Elink" ^ "elink.cfg";
    //For BE files move
    tempsvPackageloc=PACKAGE_LOCATION;
     // tempsvPackageloc="D:\\SVN\\branch\\Products\\AO\\AO6.0\\AOInstallShield 6.0 Release\\Media\\AO Installation\\Package\\AO60_Installation.exe";
    StrSub(svPackageloc,tempsvPackageloc,0,StrLength(tempsvPackageloc)-StrLength(svPackageName));
    //MessageBox(svPackageloc,INFORMATION);
    if FindFile(svPackageloc  ^ svPackageFolderName,svPakFile1,svovnmPakfile)= 0 || FindFile(svPackageloc,svPakFile1,svovnmPakfile)= 0 then
    	bPakFile1=TRUE;
    else
    	bPakFile1=FALSE;
    endif;
    if FindFile(svPackageloc ^ svPackageFolderName,svPakFile2,svovnmPakfile)= 0 || FindFile(svPackageloc,svPakFile2,svovnmPakfile)= 0 then
    	bPakFile2=TRUE;
    else
        bPakFile2=FALSE;
    endif;
    if FindFile(svPackageloc ^ svPackageFolderName,svPakFile3,svovnmPakfile)= 0 || FindFile(svPackageloc,svPakFile3,svovnmPakfile)= 0 then
    	bPakFile3=TRUE;
    else
        bPakFile3=FALSE;
    endif; 
    
    if FindFile(svPackageloc ^ svPackageFolderName,svPakFile4,svovnmPakfile)= 0 || FindFile(svPackageloc,svPakFile4,svovnmPakfile)= 0 then
    	bOCCWebFile=TRUE;
    else
    	bOCCWebFile=FALSE;
    endif; 
    
     //RBAC web change
    if FindFile(svPackageloc ^ svPackageFolderName,svPakFile5,svovnmPakfile)= 0 || FindFile(svPackageloc,svPakFile5,svovnmPakfile)= 0 then
    	bRBACWebFile=TRUE;
    else
    	bRBACWebFile=FALSE;
    endif; 
    
    //derby db changes
    if FindFile(svPackageloc ^ svPackageFolderName,svderbydb,svovnmPakfile)= 0 || FindFile(svPackageloc,svderbydb,svovnmPakfile)= 0 then
    	bderbydb=TRUE;
    else
    	bderbydb=FALSE;
    endif; 
    
    svReadMeFile="*.txt";
    svDocFile="*.pdf";
    svDocFolder="docs";  
    
    
    if FindFile(svPackageloc  ^ svDocFolder,svReadMeFile,svovnmPakfile)= 0 || FindFile(svPackageloc,svReadMeFile,svovnmPakfile)= 0 then
    	bReadMEFile=TRUE;
    else
    	bReadMEFile=FALSE;
    endif;
     if FindFile(svPackageloc  ^ svDocFolder,svDocFile,svovnmPakfile)= 0 || FindFile(svPackageloc,svDocFile,svovnmPakfile)= 0 then
    	bDocFile=TRUE;
    else
    	bDocFile=FALSE;
    endif;
    
 	//Check for ObjectMAP Package
	if  (RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{0B2F11CC-9C08-4F6C-8561-85C7624F7966}","DisplayName", nvType, svValue, nvSize) == 0) then
	     bObjMapInstallation=TRUE;
	endif;
	//Check for Console Package
	if  (RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{743411EA-7B6B-4826-BA62-A82926003D8C}","DisplayName", nvType, svValue, nvSize) == 0) then
	     bConsoleInstallation=TRUE;
	endif;
	//Check for Reporter Package
	if  (RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{62DDDCFD-5FF7-42B9-8AD2-CF1228077854}","DisplayName", nvType, svValue, nvSize) == 0) then
	 	 bReporterInstallation=TRUE;
	endif;
	//Check forVision Package
	if (RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{765B9A42-44A3-11D7-A9B4-008048B7B06E}", "DisplayName", nvType, svValue, nvSize) == 0) then
	     bVisionInstallation=TRUE;
	endif;
	//Check Old Vision Reporter
	if (RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{E40B5B5D-BD8A-4325-8432-75DFD2B2D913}", "DisplayName", nvType, svOldVisionReporterValue, nvSize) == 0) then 
 		bOldVisionReporterAgent=TRUE;
 	endif; 
 	 if (RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{938D7A10-5273-44E9-9F02-934ADFC89667}", "DisplayName", nvType, svValue, nvSize) == 0) then
 	 	bSNMPAdapter=TRUE;	
 	 endif; 
 	 
 	 //TO check OV Adapter
 	 if (RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{091144EA-2988-4EE8-960D-C2D1A070547E}", "DisplayName", nvType, svValue, nvSize) == 0) then
 	 	bOVAdapter=TRUE;	
 	 endif; 
 	if (RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{78A4D9D7-7F49-4394-8EA5-4E473C100CF5}","DisplayName", nvType, svValue, nvSize) == 0) then	        
    	bOVNMTadapterInstallation=TRUE;     	
    endif; 
    //TO check OVNPM Dispaly Agent
    if(RegDBGetKeyValueEx("SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{EDCB5B91-5C04-410E-B376-1A6D7ACEBB33}", "DisplayName", nvType, szProductDisplayAgent, nvSize) = 0) then
 		bOVNPMDisplayInstallation = TRUE;
 	endif;
 	// To check OVNPM Reporter 
	if(RegDBGetKeyValueEx("SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{C64A4C0F-29A7-434B-882B-E7DE92AB499B}", "DisplayName", nvType, szProductReporterAgent, nvSize) = 0) then
 	      bOVNPMReporterInstallation = TRUE;
 	endif; 
 	//To check OVNPM plugin
 	if(RegDBGetKeyValueEx("SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{E75DAE9F-548F-4D28-A0C6-A2F7681821D9}", "DisplayName", nvType, szProductPlugin, nvSize) = 0) then
 		bOVNPMPluginInstallation = TRUE;  	
	endif;
	 
 	if(MAINTENANCE) then
 		MaintenaceFlag = TRUE; 		  
		RegDBGetKeyValueEx ("Software\\ESQ\\" + svOldProduct, "CompanyName", nvType, svCompany, nvSize);
		RegDBGetKeyValueEx ("Software\\ESQ\\" + svOldProduct, "UserName", nvType, svName, nvSize);
	else
		if (RegDBKeyExist("Software\\ESQ\\OpenNET/AO 2.5") = 1) then
			svOldProduct = "OpenNET/AO 2.5"; 
			MaintenaceFlag = TRUE; 
		endif;
		if (RegDBKeyExist("Software\\ESQ\\OpenNET/AO 2.0") = 1) then
			svOldProduct = "OpenNET/AO 2.0";
			MaintenaceFlag = TRUE; 
		endif; 		
		if(!MaintenaceFlag) then
    		 if  (!bObjMapInstallation) then
	    		 if(RegDBGetKeyValueEx ("SOFTWARE\\ESQ\\AO", "AppPath", nvType, szAOPath, nvSize) = 0) then
	    		 	SprintfBox(INFORMATION,
	   						IFX_PRODUCT_NAME + " Installation",
							"Another OpenNET product is already on this PC.  You can not install this product until you remove installed OpenNET product." );
					//abort;
				endif;
    		endif;
    	endif;
	endif; 		
 	szProduct = "OpenNET/AO "+IFX_PRODUCT_VERSION+"";
 	if(MaintenaceFlag) then
 		if(StrCompare(szProduct,svOldProduct) > 0) then 
 			if(StrCompare(svOldProduct,"OpenNET/AO 3.0") < 0) then
 				SprintfBox(
   					INFORMATION,
   					"Older Version detected...",
					"Setup has detected " + svOldProduct + " on your system. To install the " + szProduct + 
   				    " Please Uninstall the " + svOldProduct + ", then run setup again."
  				   );
   				abort;	
 			endif;
 			bOlderVersion = TRUE;  
 			SetDialogTitle (DLG_ASK_YESNO, szProduct + " Installation");
 			if(AskYesNo ("You are upgrading from " + svOldProduct + " to " + szProduct + "\r\n" +
 						 "Do you wish to continue?", YES) = NO) then
 				
 				abort;	
 			else
 				bUpgrade=TRUE;
 			endif;       	 			
 		else 
 			if (StrCompare(szProduct,svOldProduct) < 0) then
 				SprintfBox(
   					INFORMATION,
   					"Newer Version detected...",
					"Setup has detected " + svOldProduct + " on your system. To install the " + szProduct + 
   				    " Please Uninstall the " + svOldProduct + ", then run setup again."
  				   );
   				abort;
 			endif;
		endif; 			
 	endif; 
 	
 	 //5.3 changes 
 	 
 	 //To check Elink existance in case of first installation or modify or repair
 	 if  bSNMPAdapter=TRUE || bConsoleInstallation=TRUE || bOVNMTadapterInstallation=TRUE then
 	 	bPreviousElinkInstall=TRUE;
 	 endif;
 	
 	//To check Elink existance in case of first installation
 	if(MAINTENANCE) then
		
    else                
    	if(RegDBGetKeyValueEx("Software\\ESQ\\ELink","CFGFileName",nvType,svElinkCFGFile,nvSize) = 0)then
    		bPreviousElinkInstall=TRUE; 			
     	endif;
    
    endif;
    if bUpgrade=TRUE && (StrCompare(svOldProduct,"OpenNET/AO "+IFX_PRODUCT_VERSION+"")< 0)then
    	DeleteDir(TARGETDIR ^ "Back end" ^ "help",ONLYDIR);   
    	DeleteDir(TARGETDIR ^ "Back end" ^ "help",ALLCONTENTS);
    endif;
 	 if(MAINTENANCE) then
	 	 if b64bitOS=FALSE then
	 	   //	CopyFile(TARGETDIR ^ "Elink" ^ "elink.cfg", szSystemRoot32 ^ "Elink" ^ "elink.cfg"); 
	 	 else
	 	  // 	CopyFile(TARGETDIR ^ "Elink" ^ "elink.cfg", szSystemRoot64 ^ "Elink" ^ "elink.cfg"); 
	 	 endif;	
	  endif;
 	/*SdShowMsg (szUpdateMsg, FALSE);	
    
            szJavaPath=TARGETDIR ^ "Back End" ;
    	    LongPathToShortPath(szJavaPath); 
    	    
    	    
    	    
    	    //if ExistsDir(szJavaPath ^ "Java")=1 then
    	    if (ExistsDir (szJavaPath ^ "Java") = EXISTS) then


				//SetFileInfo ( TARGETDIR ^ "OVNMJRE" ^ "LICENSE", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
				//SetFileInfo ( TARGETDIR ^ "OVNMJRE" ^ "LICENSE_fr.rtf", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
				//SetFileInfo ( TARGETDIR ^ "OVNMJRE" ^ "LICENSE_zh_CN.rtf", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
				//SetFileInfo ( TARGETDIR ^ "OVNMJRE" ^ "LICENSE_zh_TW.rtf", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
				//MessageBox(szJavaPath ^ "Java",INFORMATION);
				//szUpdateMsg ="Removing old JRE 1.4 version files.";
				//SdShowMsg (szUpdateMsg, TRUE);
				DeleteFile( szJavaPath ^ "Java"  ^ "*.*"); 
				DeleteFile( szJavaPath ^ "Java" ^ "bin"  ^ "*.*"); 
				DeleteFile( szJavaPath ^ "Java" ^ "lib"  ^ "*.*");
				DeleteFile( szJavaPath ^"Java" ^ "JavaWS"  ^ "*.*"); 
				DeleteDir(szJavaPath ^ "Java" ^ "bin",ALLCONTENTS); 
				DeleteDir(szJavaPath ^ "Java" ^ "lib",ONLYDIR);
				DeleteDir(szJavaPath ^ "Java" ^ "lib",ALLCONTENTS);
				DeleteDir(szJavaPath ^ "Java" ^ "JavaWS",ALLCONTENTS);
				DeleteDir(szJavaPath ,ONLYDIR);
				DeleteDir(szJavaPath ^ "Java",ALLCONTENTS);
				SdShowMsg (szUpdateMsg, FALSE);	
			endif;*/ 
 	//check system details
 	CheckSystemDetails();               
 	SdProductName (szProduct); 
    szDLLName = SUPPORTDIR^"OVOPSDLL.DLL";
	UseDLL (szDLLName);
    return 0;
 end; 

function OnFirstUIBefore()
    NUMBER  nResult,nSetupType;
    STRING  szTitle, szMsg;
    STRING  szLicenseFile, szQuestion;
    STRING  szFile;
    STRING  szDir;
    STRING  szfolder;     
    STRING  szComponents;
    STRING  szName;
    NUMBER  nLevel;
    LIST    listStartCopy;
    LIST    list, listEventLogger;
    NUMBER  nvSize, nvType;
    STRING nDBname;
    STRING svValue,svTargetStr,szSQLInstanceName;
    BOOL   bAskReporterDBPath;
    STRING sResult;
    BOOL bLoggerComponent;
begin	                         
	//To Do:	 if you want to enable background, window title, and caption bar title                                                                     
	bLoggerComponent=FALSE;
	SetFont (FONT_TITLE,STYLE_BOLD,"Arial");    
	if(nvDx > 790) then
		SetTitle( "OpenNET/AO "+IFX_PRODUCT_VERSION+"", 24, RGB(50,77,148));                        
	else
		SetTitle( "OpenNET/AO "+IFX_PRODUCT_VERSION+"", 16, RGB(50,77,148));		
	endif;		
	SetDisplayEffect (EFF_NONE);
    SetTitle( "OpenNET/AO "+IFX_PRODUCT_VERSION+"", 0, BACKGROUNDCAPTION );
	Enable( FULLWINDOWMODE );						   
	Enable( BACKGROUND );							  
	//Enable(STATUSEX);
	SetColor(BACKGROUND,RGB (255, 255, 255));
	PlaceWindow (BILLBOARD, 200, 150, UPPER_LEFT);   
	nSetupType = TYPICAL;	
	if bReporterInstallation=TRUE then
		RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{62DDDCFD-5FF7-42B9-8AD2-CF1228077854}","InstallLocation", nvType, svValue, nvSize);
		TARGETDIR=svValue;
		szDir=TARGETDIR;
		RegDBGetKeyValueEx("Software\\ODBC\\ODBC.INI\\AOReporter", "DBQ", nvType, svValue, nvSize);
	    StrSub (svTargetStr, svValue, 0, StrLength(svValue)-StrLength("\\Reporter\\AONEWDB.MDB"));
	    szDatabase=svTargetStr ^"Reporter";
	    szReporterDSNPath=svTargetStr;
	    goto Dlg_Start;
	elseif bConsoleInstallation=TRUE then
		RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{743411EA-7B6B-4826-BA62-A82926003D8C}","InstallLocation", nvType, svValue, nvSize);
	    TARGETDIR= svValue;
	    szReporterDSNPath=TARGETDIR;
	    goto Dlg_Start; 
	elseif bObjMapInstallation=TRUE then
		RegDBGetKeyValueEx("Software\\ESQ\\AO", "AppPath", nvType, svValue, nvSize);
	    StrSub (svTargetStr, svValue, 0, StrLength(svValue)-StrLength("\\ObjectMap"));   
	   	TARGETDIR= svTargetStr;
	   	szReporterDSNPath=TARGETDIR;
		goto Dlg_Start;
	else
		TARGETDIR = PROGRAMFILES ^ IFX_COMPANY_NAME ^ "OpenNET";	
	    szDir = TARGETDIR;
    endif;	    
    //SHELL_OBJECT_FOLDER = @FOLDER_NAME;
    svSerial = "";

				
Dlg_Start:
    // beginning of dialogs label
    if(nvDx < 610 ) then
    	PlaceBitmap (SUPPORTDIR ^ "Screen1.bmp", 10, 0, 0, FULLSCREENSIZE);
	elseif(nvDx < 810) then
	   PlaceBitmap (SUPPORTDIR ^ "Screen2.bmp", 10, 0, 0, FULLSCREENSIZE);
	else
	   PlaceBitmap (SUPPORTDIR ^ "Screen3.bmp", 10, 0, 0, FULLSCREENSIZE);
	endif;
Dlg_SdWelcome:
    szTitle = "Welcome to " + szProduct + " Installation";
    szMsg   = "Before proceeding, we suggest you close all open applications...";
    nResult = SdWelcome( szTitle, szMsg );
    if (nResult = BACK) goto Dlg_Start;

Dlg_SdLicense:
    szLicenseFile = SUPPORTDIR ^ "license.txt";
    szTitle    = "Software License Agreement";
    szMsg      = "This is the copy of the agreement you need to sign before"+
               " using this software.";
    szQuestion = "Are you willing to abide by the terms of the agreement?";
    nResult    = SdLicense( szTitle, szMsg, szQuestion, szLicenseFile );
    if (nResult = BACK) goto Dlg_SdWelcome;

/*Dlg_SdRegisterUserEx:
    szTitle   = "User Registration";
    szMsg = "Please enter User and Company Name";	
    nResult = SdRegisterUser( szTitle, szMsg, svName, svCompany );
    if (nResult = BACK) goto Dlg_SdLicense; 
    if (StrLength(svName) > 30) then
         MessageBox ("UserName can be of max 30 characters",INFORMATION); 
         goto   Dlg_SdRegisterUserEx;
    endif;
    if (StrLength(svCompany) > 30) then
         MessageBox ("Company Name can be of max 30 characters",INFORMATION); 
         goto   Dlg_SdRegisterUserEx;
    endif;*/ 
Dlg_SdAskDestPath:
    if (bReporterInstallation=FALSE && bConsoleInstallation=FALSE && bObjMapInstallation=FALSE) then
	    szTitle = "";
	    if bPakFile1=FALSE || bPakFile2=FALSE || bPakFile3=FALSE || bOCCWebFile=FALSE || bRBACWebFile=FALSE || bderbydb=FALSE then
	    	//szMsg="Warning: The backend files "+"('"+svPakFile1+"'/'"+svPakFile2+"')"+" are not located in "+ "'"+ svPackageloc  ^ svPackageFolderName+ "'"+ " or in "+ "'"+ svPackageloc+ "'" +" folder."+" Before continuing, please move the backend files "+"('"+svPakFile1+"'/'"+svPakFile2+"')"+" from provided folder into "+ "'"+ TARGETDIR ^ "Back end"+ "'"+".";
	    	//Disable(NEXTBUTTON);
	    	szMsg="Warning:\n\t"+
            "The install Location "+"'"+svPackageloc+"'" +" does not contain files "+"'"+svPakFile1+"'/'"+svPakFile2+"'/'"+svPakFile3+"'/'"+svPakFile4+"'/'"+svPakFile5+"'"+"'/'"+svderbydb+"'"+"\n\t"+
            "Please Paste the stated files from "+"'"+svPackageFolderName+"'"+" folder." +"\n\t"+
            "Otherwise the HIC (Host Installation Client) will not be able to install backend components.";
	    else
	    	szMsg   = "";
	    endif;
	    nResult = SdAskDestPath( szTitle, szMsg, szDir, 0 );
	    TARGETDIR = szDir;
	    szReporterDSNPath=szDir;
	    if (nResult = BACK) goto Dlg_SdLicense;    
    endif;
Dlg_SetupType:   
    szTitle    = "";
    szMsg      = "";
    nResult = SetupType ( szTitle , szMsg , "" , nSetupType , 0 );
    //if bLoggerComponent=TRUE then
    	//FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Event Logger", TRUE);
    //elseif bLoggerComponent=FALSE then
    	//FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Event Logger",FALSE);
    //endif;
    if bConsoleInstallation=TRUE then
 		 FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Console", TRUE);
 		 if RegDBKeyExist("Software\\ESQ\\EMSLoggerService")=1 then
 		 	 FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Event Logger", TRUE);
 		 endif;
 	endif;
    if (bReporterInstallation=FALSE && bConsoleInstallation=FALSE && bObjMapInstallation=FALSE) then
	    if (nResult = BACK) then
	        goto Dlg_SdAskDestPath;
	    endif;
	else
		if (nResult = BACK) then
	        goto Dlg_SdLicense;
	    endif;
    endif;	                   
  		FeatureSelectItem(MEDIA, "AO 2.0\\InstalledJREComponent", FALSE);		
		if FeatureIsItemSelected(MEDIA, "AO 2.0\\Back End")=TRUE then
			//SelectJavaRunTimeComponent();
		endif;                                                    
      
        nSetupType = nResult;
    
Dlg_SdComponentTree: 
    if ((nResult = BACK) && (nSetupType != CUSTOM)) then
    	if FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger")=TRUE then
				bLoggerComponent=TRUE;
		elseif  FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger")=FALSE then
				bLoggerComponent=FALSE;
		endif;
			goto Dlg_SetupType;
     endif;
    szTitle    = "";
    szMsg      = "";
    szComponents = "";
    nLevel = 3;
    if (nSetupType = CUSTOM) then
        nResult = SdFeatureTree(szTitle, szMsg, TARGETDIR, szComponents, nLevel);
	    if (nResult = BACK) then
	    	//if FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger")=TRUE then
				//bLoggerComponent=TRUE;
			//elseif FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger")=FALSE then
				//bLoggerComponent=FALSE;
			//endif;
			goto Dlg_SetupType;
    	endif;    
	    if (!(FeatureIsItemSelected(MEDIA, "AO 2.0\\AO Configuration Client")) 
	    && !(FeatureIsItemSelected(MEDIA, "AO 2.0\\Object Map"))
	    && !(FeatureIsItemSelected(MEDIA, "AO 2.0\\Elink Manager"))
	    && !(FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Console"))
	    && ! (FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger"))) then
      		MessageBox( "Please select at least one Component", WARNING );
		    goto Dlg_SdComponentTree;
		endif;  
    	
    endif;
    /*Added by YK on 07Dec2004*/
Dlg_EventLoggerInfo:   
	if FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger")=TRUE then
		listEventLogger = ListCreate( STRINGLIST );
		ListAddString(listEventLogger,"Event Logger Information:-",AFTER);
		ListAddString(listEventLogger,"",AFTER);
  		ListAddString(listEventLogger, "           You have selected the option to install the Event Logger.", AFTER);
  		ListAddString(listEventLogger, "           Event Logger requires OpenNET SQL instance to be installed.", AFTER);
  		ListAddString(listEventLogger, "           This process takes extra time and may require the SQL user id and password.", AFTER);
  		ListAddString(listEventLogger, "           Once it is installed it will run as a background service.", AFTER);
  		ListAddString(listEventLogger, "",AFTER); 
  		ListAddString(listEventLogger, "           If you do not want to install Event Logger, click the Back button and",AFTER);
  		ListAddString(listEventLogger, "           Un-select the Event Logger option.", AFTER);
