		RegDBDeleteKey("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{0B2F11CC-9C08-4F6C-8561-85C7624F7955}"); 
		RegDBSetDefaultRoot(HKEY_CURRENT_USER);
    	RegDBDeleteKey ("SOFTWARE\\ESQ\\AO");     	
    	
    	RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
    	DeleteFile (TARGETDIR ^ "README.txt");
    	DeleteFile (TARGETDIR ^ "Start.vbs");
    	DeleteFile (TARGETDIR ^ "Stop.vbs");
    	//DeleteDir (DISK1TARGET,ALLCONTENTS); 
    	DeleteDir(TARGETDIR ^ "Back end" ^"Java",ALLCONTENTS);
    	DeleteDir(TARGETDIR ^ "AO",ALLCONTENTS);
    	DeleteDir(TARGETDIR ^ "Back end",ALLCONTENTS);
    	DeleteDir(TARGETDIR ^ "dotnet20",ALLCONTENTS);
    	//DeleteDir(TARGETDIR ^ "Elink",ALLCONTENTS);
    	DeleteDir(TARGETDIR ^ "ObjectMap",ALLCONTENTS);  
    	DeleteDir(TARGETDIR ^ "Doc",ALLCONTENTS);
    	DeleteDir(TARGETDIR ^ "Reporter",ALLCONTENTS);
    	DeleteDir(TARGETDIR ^ "Console",ALLCONTENTS);  
    	DeleteDir(TARGETDIR ^ "OVNMJRE",ALLCONTENTS);
    	DeleteDir(TARGETDIR ^ "AOJRE",ALLCONTENTS);
    	SetFileInfo(TARGETDIR ^ "AO" ^ "AODB.mdb",READONLY,FILE_ATTR_NORMAL,"");
    	DeleteFile(TARGETDIR ^ "AO" ^ "AODB.mdb"); 
    	//DeleteDir(TARGETDIR,ONLYDIR);
    	//DeleteDir(TARGETDIR,ALLCONTENTS); 
    	//5.3.2 changes
    	DeleteDir(szAllUsersLoc ^ "Back End",ALLCONTENTS);    	
    	
    	
    	if bSNMPAdapter=FALSE && bOVNMTadapterInstallation=FALSE && bObjMapInstallation=FALSE && bConsoleInstallation=FALSE && bReporterInstallation=FALSE then 
    		RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);     		
    		DeleteDir(TARGETDIR ^ "Elink",ALLCONTENTS); 
    		DeleteDir(TARGETDIR,ONLYDIR);
    		DeleteDir(TARGETDIR,ALLCONTENTS);
    		/*if b64bitOS=FALSE then
				DeleteDir(szSystemRoot32 ^ "Elink" ,ALLCONTENTS);
			else
		 		DeleteDir(szSystemRoot64 ^ "Elink",ALLCONTENTS);
		 	endif;*/ 
		 	//5.3.2 changes
    		DeleteDir(szAllUsersLoc ^ "Elink",ALLCONTENTS);
    		DeleteDir(szAllUsersLoc,ALLCONTENTS);
    		
		 	RegDBSetDefaultRoot(HKEY_CURRENT_USER);
		 	RegDBDeleteKey ("SOFTWARE\\ESQ\\AO");		
			RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
	    	RegDBDeleteKey ("SOFTWARE\\ESQ\\AO"); 
	    	
		endif;
		if bSNMPAdapter=FALSE && bOVNMTadapterInstallation=FALSE && bObjMapInstallation=FALSE && bConsoleInstallation=FALSE && bReporterInstallation=FALSE && bVisionInstallation=FALSE && bOVNPMDisplayInstallation=FALSE && bOVNPMReporterInstallation=FALSE &&	bOVNPMPluginInstallation= FALSE then
			DeleteProgramFolder (FOLDER_PROGRAMS ^ "OpenNET");
		endif;
		//SetControlPanelRemoveOption();	
    	/*if bOVNM_SNMPAdapterInstallation=FALSE && bOVNMTadapterInstallation=FALSE then
       		DeleteProgramFolder(FOLDER_PROGRAMS ^ "HP OVNM");   
    		DeleteDir (FOLDER_PROGRAMS + "HP OVNM", ONLYDIR);
       		DeleteDir (DISK1TARGET,ALLCONTENTS); 
			DeleteDir (TARGETDIR , ALLCONTENTS);
			DeleteDir (TARGETDIR, ONLYDIR);
			// 5.3 Changes
			if b64bitOS=FALSE then
				DeleteDir(svSysdir ^ "All Users" ^ "Application Data" ^ "AO",ALLCONTENTS);
			else
			   DeleteDir(svSysdir ^"All Users" ^ "AO",ALLCONTENTS);
			endif;        
			//
			//DeleteDir (szSystemRoot , ALLCONTENTS);
			//DeleteDir (szSystemRoot, ONLYDIR);    
			DeleteProgramFolder (FOLDER_PROGRAMS ^ "AO");	
       	endif;*/
    	if bReporterInstallation=TRUE then
    		RegDBDeleteKey("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{62DDDCFD-5FF7-42B9-8AD2-CF1228077854}");
    		RegDBDeleteKey("Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\Reporter.exe");
    		DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET","Uninstall Reporter");
    		RegDBDeleteKey("Software\\ESQ\\OpenNET/Reporter 1.3");
    	endif;
    	if bConsoleInstallation=TRUE then
    		if RegDBKeyExist("Software\\ESQ\\EMSLoggerService") = 1 then
	    		RemovingAOLoggerDB();
				RemoveLoggerService();
				RemoveRegAOLogger();
				UnInstallOpenNETInstance();
				DeleteDir(TARGETDIR ^ "Logger" ^ "SQL",ALLCONTENTS);
				DeleteDir(TARGETDIR ^ "Logger" ^ "MSSQL$OPENNET",ALLCONTENTS);
				RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
				RegDBDeleteKey("Software\\ESQ\\EMSLoggerService");
			endif;
    		RegDBDeleteKey("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{743411EA-7B6B-4826-BA62-A82926003D8C}");
    		RegDBDeleteKey("Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\Console.exe");
    		RegDBDeleteKey("Software\\ESQ\\OpenNET/Console 1.1");
    		RegDBDeleteKey("Software\\ESQ\\OpenNET/Console 1.1.0");
    		RegDBDeleteKey("Software\\ESQ\\Installed Products");
    		DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET","Uninstall Console");
    	endif;
    	if bObjMapInstallation=TRUE then
    		RegDBDeleteKey("Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{0B2F11CC-9C08-4F6C-8561-85C7624F7966}");
    		RegDBDeleteKey("Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\ObjectMap.exe");
    		RegDBDeleteKey("Software\\ESQ\\OpenNET/AO 3.3");
    		DeleteFolderIcon(FOLDER_PROGRAMS ^ "OpenNET","Uninstall ObjectMap");
    	endif;  
    	
    	listItemsID = ListCreate (STRINGLIST);
        listFoldersID = ListCreate (STRINGLIST);
        if (listItemsID != LIST_NULL) && (listFoldersID != LIST_NULL) then
           	// Place the folder and program names into the lists.
      		nResult = GetFolderNameList (FOLDER_PROGRAMS ^ "OpenNET", listItemsID, listFoldersID);
            if(ListGetFirstString(listItemsID,szProgramFolder) != 0 && ListGetFirstString(listFoldersID,szProgramFolder) != 0) then 
           		DeleteProgramFolder (FOLDER_PROGRAMS ^ "OpenNET"); 
			endif; 
			ListDestroy(listItemsID);
			ListDestroy(listFoldersID);
    	endif;
    	DeleteFile(TARGETDIR ^ "AO" ^ "AODB.mdb");
    	/* Add by Sachin on 10th Dec,2004 */
    	if bRemoveLogger=TRUE then
       			SprintfBox(INFORMATION,
	   						IFX_PRODUCT_NAME + " Uninstallation","It is recommended to reboot the system to complete the uninstallation.");
    	endif;
    	Disable( FULLWINDOWMODE );						   
      	Disable( BACKGROUND ); 
      	SdShowMsg (szUpdateMsg, FALSE);
      	szUpdateMsg = "Thanks for using " + szProduct +"."; 
      	SdShowMsg (szUpdateMsg, TRUE);
    	Delay(3);
    	SdShowMsg (szUpdateMsg, FALSE);	   
    endif; 
end;
 
///////////////////////////////////////////////////////////////////////////////
//
//  FUNCTION:   OnMaintUIBefore
//
//  EVENT:      MaintUIBefore event is sent when end user runs installation that
//              has already been installed on the machine. Usually this happens 
//              through Add/Remove Programs applet. In the handler installation 
//              usually displays UI allowing end user to modify existing installation
//              or uninstall application. After this function returns, 
//              ComponentTransferData is called to perform file transfer.
//
///////////////////////////////////////////////////////////////////////////////
function OnMaintUIBefore()
    NUMBER nResult, nType, nvType, nvSize;
    STRING szTitle, szMsg, svDir, svResult, szCaption, oldCFGFileName; 
    STRING szPath, szCmd, svLine, szNewDir, szService,sResult,szJavaPath;
    NUMBER nvNewElinkhandle, nvOldElinkhandle;
    STRING svTmpOldPath,svTmpPath;//For import utility 
    STRING nDBname,szSQLInstanceName;
    LIST    listStartCopy, listEventLogger;
    NUMBER nvServiceState,nLocation;   
    BOOL   bAskReporterDBPath,bLoggerComponent; 
    STRING svElinkPath,svElinkAppPath;
    STRING szProgram,szCmdLine;
begin
	// TO DO: if you want to enable background, window title, and caption bar title   								
	SetFont (FONT_TITLE,STYLE_BOLD,"Arial");  
	if(nvDx > 790) then
		SetTitle( "OpenNET/AO "+IFX_PRODUCT_VERSION+" Maintenance", 24, RGB(50,77,148));                        
	else
		SetTitle( "OpenNET/AO "+IFX_PRODUCT_VERSION+" Maintenance", 16, RGB(50,77,148));		
	endif;	
	SetDisplayEffect (EFF_NONE);
    SetTitle( "OpenNET/AO "+IFX_PRODUCT_VERSION+"", 0, BACKGROUNDCAPTION );
	Enable( FULLWINDOWMODE );						   
	Enable( BACKGROUND );							  
	SetColor(BACKGROUND,RGB (255, 255, 255));  
	
	RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
  	RegDBGetKeyValueEx ("Software\\ESQ\\" + svOldProduct, "CompanyName", nvType, svCompany, nvSize);
	RegDBGetKeyValueEx ("Software\\ESQ\\" + svOldProduct, "UserName", nvType, svName, nvSize);

	nType = MODIFY;
	if(StrFind(CMDLINE,"REMOVE") >= 0) then
		nType = REMOVEALL;		
	endif; 	
    PlaceWindow (BILLBOARD, 200, 150, UPPER_LEFT);
    if(nvDx < 610 ) then
    	PlaceBitmap (SUPPORTDIR ^ "Screen1.bmp", 10, 0, 0, FULLSCREENSIZE);
	elseif(nvDx < 810) then
	   PlaceBitmap (SUPPORTDIR ^ "Screen2.bmp", 10, 0, 0, FULLSCREENSIZE);
	else
	   PlaceBitmap (SUPPORTDIR ^ "Screen3.bmp", 10, 0, 0, FULLSCREENSIZE);
	endif;
	SprintfBox( INFORMATION,
				szProduct,
				"Before continuing please close all the OpenNET/AO components running on your system.");    
    FeatureSelectItem(MEDIA, "AO 2.0\\Back End", TRUE);	
 	if bReporterInstallation=TRUE then
 		 FeatureSelectItem(MEDIA, "AO 2.0\\Reporter", TRUE);
 	endif;
 	if bObjMapInstallation=TRUE then
 		 FeatureSelectItem(MEDIA, "AO 2.0\\ObjectMap", TRUE);
 	endif;
 	
 	if (FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter")) then
		if(RegDBGetKeyValueEx("Software\\ESQ\\AOReporter","DBPath",nvType,szReporterDSNPath,nvSize) < 0) then
			RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\AO.exe","Path",nvType,szReporterDSNPath,nvSize);
		endif;
   	 	if FindFile(szReporterDSNPath ^ "Reporter","AONEWDB.MDB",sResult)=0 then
	   	 	szPath =  SUPPORTDIR ^ "UpdateTables.exe"; 
		 	LongPathToQuote( szPath, TRUE);
		 	szCmd = "";
		 	LaunchAppAndWait  ( szPath, szCmd, WAIT);  
	    endif;
	endif;
	
	SdShowMsg (szUpdateMsg, FALSE);	
    
            szJavaPath=TARGETDIR ^ "Back End" ;
    	    LongPathToShortPath(szJavaPath); 
    	    
    	    //if ExistsDir(szJavaPath ^ "Java")=1 then
    	    if (ExistsDir (szJavaPath ^ "Java") = EXISTS) then

				//SetFileInfo ( TARGETDIR ^ "OVNMJRE" ^ "LICENSE", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
				//SetFileInfo ( TARGETDIR ^ "OVNMJRE" ^ "LICENSE_fr.rtf", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
				//SetFileInfo ( TARGETDIR ^ "OVNMJRE" ^ "LICENSE_zh_CN.rtf", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
				//SetFileInfo ( TARGETDIR ^ "OVNMJRE" ^ "LICENSE_zh_TW.rtf", FILE_ATTRIBUTE, FILE_ATTR_NORMAL, "");
				//MessageBox(szJavaPath ^ "Java",INFORMATION);
				//szUpdateMsg ="Removing old JRE 1.4 version files.";
				//SdShowMsg (szUpdateMsg, TRUE);
				DeleteFile( szJavaPath ^ "Java"  ^ "*.*"); 
				DeleteFile( szJavaPath ^ "Java" ^ "bin"  ^ "*.*"); 
				DeleteFile( szJavaPath ^ "Java" ^ "lib"  ^ "*.*");
				DeleteFile( szJavaPath ^"Java" ^ "JavaWS"  ^ "*.*"); 
				DeleteDir(szJavaPath ^ "Java" ^ "bin",ALLCONTENTS); 
				DeleteDir(szJavaPath ^ "Java" ^ "lib",ONLYDIR);
				DeleteDir(szJavaPath ^ "Java" ^ "lib",ALLCONTENTS);
				DeleteDir(szJavaPath ^ "Java" ^ "JavaWS",ALLCONTENTS);
				DeleteDir(szJavaPath ,ONLYDIR);
				DeleteDir(szJavaPath ^ "Java",ALLCONTENTS);
				SdShowMsg (szUpdateMsg, FALSE);	
			endif;
	//5.3.2 changes
	if MAINTENANCE && (StrCompare(svOldProduct,"OpenNET/AO 5.3.2")< 0)then
    	DeleteDir(TARGETDIR ^ "Back end" ^ "help",ONLYDIR);   
    	DeleteDir(TARGETDIR ^ "Back end" ^ "help",ALLCONTENTS);
    endif;
Dlg_Start:
	Disable(BACKBUTTON);
	nType = SdWelcomeMaint(szTitle, szMsg, nType);
	nUninstallType = nType;
	Enable(BACKBUTTON);      
	 if (nType = REMOVEALL) then
		svResult = SdLoadString(IFX_MAINTUI_MSG);
		szCaption = SdLoadString(IFX_ONMAINTUI_CAPTION);
		nResult = SprintfBox(MB_OKCANCEL,szCaption,"%s",svResult);
		if (nResult = IDCANCEL) goto Dlg_Start;
	endif;
  	bElink = FeatureIsItemSelected(MEDIA, "AO 2.0\\Elink Manager");
	bConfig = FeatureIsItemSelected(MEDIA, "AO 2.0\\AO Configuration Client");  

Dlg_SdComponentTree:  
	FeatureSelectItem(MEDIA, "AO 2.0\\InstalledJREComponent", FALSE);
	if FeatureIsItemSelected(MEDIA, "AO 2.0\\Back End")=TRUE then
		//SelectJavaRunTimeComponent();
	endif;		
    if bConsoleInstallation=TRUE then
 		 FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Console", TRUE);
 		 if RegDBKeyExist("Software\\ESQ\\EMSLoggerService")=1 then
 		 	 FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Event Logger", TRUE);
 		 endif;
 	endif;
    if(StrCompare(svOldProduct,"OpenNET/AO 3.3") = 0) then
	    if FeatureIsItemSelected(MEDIA, "AO 2.0\\Console")=TRUE then
			FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Console",TRUE);
			/*Change by Sachin on 10th Dec 2004 */
			//Reason: To select Event Logger Component if Console is selected in AO 3.3
			FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Event Logger",FALSE);
		elseif FeatureIsItemSelected(MEDIA, "AO 2.0\\Console")=FALSE then
			FeatureSelectItem(MEDIA, "AO 2.0\\Console",FALSE);
			FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Console",FALSE);
			FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Event Logger",FALSE);
		endif;
	endif;
	if(StrCompare(svOldProduct,"OpenNET/AO 3.3") < 0) then
			FeatureSelectItem(MEDIA, "AO 2.0\\Console",FALSE);
			FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Console",FALSE);
			FeatureSelectItem(MEDIA, "AO 2.0\\Console\\Event Logger",FALSE);
	endif;
	if (nType = MODIFY) then
		szTitle = "";
		szMsg = "";
		nResult = SdFeatureTree(szTitle, szMsg, TARGETDIR, "", 3);
		if (!(FeatureIsItemSelected(MEDIA, "AO 2.0\\AO Configuration Client")) 
	    && !(FeatureIsItemSelected(MEDIA, "AO 2.0\\Object Map"))
	    && !(FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter"))
	    && !(FeatureIsItemSelected(MEDIA, "AO 2.0\\Elink Manager"))
	    && !(FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Console"))
	    && !(FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger"))) then
      		MessageBox( "Please select at least one Component", WARNING );
		    goto Dlg_SdComponentTree;
		endif;
		if (nResult = BACK)  then
			goto Dlg_Start;
    	endif;
    endif;

	bAskReporterDBPath = FALSE;
	if FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter")=TRUE then
		if (RegDBKeyExist("Software\\ESQ\\AOReporter") <0) then
			bAskReporterDBPath = TRUE;
		else                       
			if(RegDBGetKeyValueEx("Software\\ESQ\\AOReporter","DBPath",nvType,szReporterDSNPath,nvSize) < 0) then
				RegDBGetKeyValueEx("Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\AO.exe","Path",nvType,szReporterDSNPath,nvSize);
			endif;
   	 		if FindFile(szReporterDSNPath ^ "Reporter","AONEWDB.MDB",sResult)<0 then
   	 			bAskReporterDBPath = TRUE;
   	 		endif;
	   	
		endif;
	endif; 
Dlg_EventLoggerInfo:   
	if FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger")=TRUE &&
		RegDBKeyExist("Software\\ESQ\\EMSLoggerService") != 1 then
		listEventLogger = ListCreate( STRINGLIST );
		ListAddString(listEventLogger,"Event Logger Information:-",AFTER);
		ListAddString(listEventLogger,"",AFTER);
  		ListAddString(listEventLogger, "           You have selected the option to install the Event Logger.", AFTER);
  		ListAddString(listEventLogger, "           Event Logger requires OpenNET SQL instance to be installed.", AFTER);
  		ListAddString(listEventLogger, "           This process takes extra time and may require the SQL user id and password.", AFTER);
  		ListAddString(listEventLogger, "           Once it is installed it will run as a background service.", AFTER);
  		ListAddString(listEventLogger, "",AFTER); 
  		ListAddString(listEventLogger, "           If you do not want to install Event Logger, click the Back button and",AFTER);
  		ListAddString(listEventLogger, "           Un-select the Event Logger option.", AFTER);
  		szTitle = "Event Logger Information.";
  		szMsg   = "Event Logger Information.";
  		nResult = SdShowInfoList(szTitle,szMsg,listEventLogger);  
  		ListDestroy(listStartCopy);
  		if (nResult = BACK) then
  			if nType=MODIFY then    
  				goto Dlg_SdComponentTree;
  			else
  				goto Dlg_Start;
			endif;
		endif;    			
 	endif;
Dlg_SdAskDestPathReporterDSN: 		
    if (nType = MODIFY || nType = REPAIR) && (bAskReporterDBPath = TRUE) then
	    szTitle = "Choose OpenNET/Reporter Database Location";
	    szMsg   = "To install to this folder, click Next. To install to a different folder, click Browse and select another folder.";
	    szReporterDSNPath=TARGETDIR;
	    nResult = SdAskDestPath( szTitle, szMsg, szReporterDSNPath, 0 );
	    if (nResult = BACK) then       
	   		if FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger")=TRUE &&
				RegDBKeyExist("Software\\ESQ\\EMSLoggerService") < 0 then
	   			goto Dlg_EventLoggerInfo;
	   		else
		    	goto Dlg_SdComponentTree;
		     endif;   
		endif;	   	
	endif;  
    Dlg_SdStartCopy:
     if (nType = MODIFY || nType = REPAIR) && (bAskReporterDBPath = TRUE) then
			    szTitle = "Check Setup Information.";
			    szMsg   = "Setup has enough information to begin the file-transfer\n" +
			              "operation. If you are satisfied with the settings,\n" +
			              "click Next to begin copying files.";
			    listStartCopy = ListCreate( STRINGLIST );
			    //The following is an example of how to add a string(svName) to a list(listStartCopy).
			    //eg. ListAddString(listStartCopy,svName,AFTER); 
			  	if FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter")=TRUE then
				  	if FindFile(szReporterDSNPath ^ "Reporter","AONEWDB.MDB",nDBname) <0 then
					    bReporterDatabase=FALSE;
					    ListAddString(listStartCopy, "Scheduler Information:", AFTER);
					    ListAddString(listStartCopy, "          " +"Database does not Exist. Scheduler Feature will be enabled", AFTER);
						ListAddString(listStartCopy, "", AFTER);
						
					else
						bReporterDatabase=TRUE;
						ListAddString(listStartCopy, "Scheduler Information:", AFTER);
						ListAddString(listStartCopy, "          "  + "Database already Exist. Scheduler Feature will be disabled", AFTER);
						ListAddString(listStartCopy, "", AFTER);			
					endif;
			  	endif;
			   	ListAddString(listStartCopy, "Destination Directory:", AFTER);
			  	ListAddString(listStartCopy, "           " + TARGETDIR, AFTER);
			  	ListAddString(listStartCopy, "", AFTER);
			  	if FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter")=TRUE then
				  	ListAddString(listStartCopy, "OpenNET/Reporter Destination Directory:", AFTER);
				  	ListAddString(listStartCopy, "           " + TARGETDIR ^"Reporter", AFTER);
				  	ListAddString(listStartCopy, "", AFTER);
				  	ListAddString(listStartCopy, "OpenNET/Reporter Database Directory:", AFTER);
				  	ListAddString(listStartCopy, "           " + szReporterDSNPath ^"Reporter", AFTER);
			  		ListAddString(listStartCopy, "", AFTER);
			  	endif;
			  	
			    nResult = SdStartCopy( szTitle, szMsg, listStartCopy );	
			    ListDestroy(listStartCopy);
			    if (nResult = BACK) goto Dlg_SdAskDestPathReporterDSN;
    endif;

Dlg_ObjDialogs:
    nResult = ShowObjWizardPages(nResult);  
    if(nResult = BACK) then
    	if FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter")=TRUE then
    		goto Dlg_SdStartCopy;
    	else
    		if FeatureIsItemSelected(MEDIA, "AO 2.0\\Console\\Event Logger")=TRUE then
	   			goto Dlg_EventLoggerInfo;
	   		else
		    	goto Dlg_SdComponentTree;
		    	
			endif;
    	endif;
    endif;
    
   if FeatureIsItemSelected(MEDIA, "AO 2.0\\Reporter")=TRUE then
    	FeatureSetTarget (MEDIA, "<szReporterDSNPath>", szReporterDSNPath );
    endif; 	
    //if ((nResult = BACK) && (nType = MODIFY)) then
	   // goto Dlg_SdComponentTree;
    //endif;                    
 	
 	//DeleteProgramFolder(FOLDER_PROGRAMS ^ "OpenNET" ^"AO ");
 	switch(nType)
        case REMOVEALL:
        		
			if bPreviousElinkInstall=TRUE then
 				RegDBGetKeyValueEx("Software\\ESQ\\Elink", "RemotePort", nvType, svPreviousRemotePort, nvSize);
 				RegDBGetKeyValueEx("Software\\ESQ\\Elink", "AppPath", nvType, svPreviousAppPath, nvSize);
 				RegDBGetKeyValueEx("Software\\ESQ\\Elink", "CFGFileName", nvType, svPreviousCFGFile, nvSize);
 			endif; 
        	/*if bSNMPAdapter=FALSE && bOVNMTadapterInstallation=FALSE then  
		 		RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
				if(RegDBGetKeyValueEx("Software\\ESQ\\ELink","AppPAth",nvType,svElinkAppPath,nvSize) = 0)then	
					if StrFind(svElinkAppPath,"ElinkWin32.exe")>0 then
						nLocation=StrFind(svElinkAppPath,"ElinkWin32.exe");	
						StrSub(svElinkPath,svElinkAppPath,0,nLocation-StrLength("\\"));
						//MessageBox("Please close ElinkWin32 application before proceeding.",INFORMATION);
					elseif StrFind(svElinkAppPath,"ElinkService.exe")>0 then
						nLocation=StrFind(svElinkAppPath,"ElinkService.exe");
						StrSub(svElinkPath,svElinkAppPath,0,nLocation-StrLength("\\"));
					endif;	
			    endif;
			 	if(RegDBKeyExist("SYSTEM\\CurrentControlSet\\Services\\Elink") = 1)  then
					szUpdateMsg = "Updating Elink Service.";  
					SdShowMsg (szUpdateMsg, TRUE);   
					szProgram =  svElinkPath ^ "elinkService.exe";
					//szProgram =  TARGETDIR + "\\elink\\elinkService.exe"; 
					LongPathToQuote( szProgram, TRUE);
					szCmdLine  = "-remove";
					LaunchAppAndWait  ( szProgram, szCmdLine, WAIT);
					SdShowMsg (szUpdateMsg, FALSE); 
					Delay(1);
				endif;
				endif;*/
			//RegDBSetDefaultRoot(HKEY_CURRENT_USER);
        	//RegDBDeleteKey ("SOFTWARE\\ESQ\\AO");   
			//RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);        	
        	//RegDBDeleteKey ("SOFTWARE\\ESQ\\AO"); 
			 // setup default status 
 			SetStatusWindow(0, "");
			PlaceWindow (STATUSDLG, (30*nvDx)/1024,(30*nvDy)/300, LOWER_RIGHT);
			Enable(STATUSDLG); 	
			SetStatusExStaticText( "Please wait while the Wizard is uninstalling "+ IFX_PRODUCT_NAME +"." ); 		
			StatusUpdate(ON, 100);
        	//FeatureRemoveAll(); 
        	//ComponentRemoveAll(); 
        case REPAIR:    
		    RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE); 
		    //Event Logger Service installation
		    	if(ComponentIsItemSelected (MEDIA, "AO 2.0\\Console\\Event Logger")) then
		    		//if ServiceExistsService ( "emslogsvc" )=FALSE then
			    		if RegDBKeyExist("Software\\ESQ\\EMSLoggerService")<0 then
				    		bEventLogger=FALSE;
			    		else
			    		//ServiceGetServiceState ( "emslogsvc", nvServiceState );
			    		//if nvServiceState=SERVICE_RUNNING then
			    			//ServiceStopService ( "emslogsvc" );
			    		 	 bEventLogger=TRUE;
				    		 szPath = WINSYSDIR ^ "net.exe";
							 LongPathToQuote( szPath, TRUE );
							 szCmd="stop emslogsvc";
							 LaunchAppAndWait(szPath,szCmd,WAIT);
			    		endif;
			    endif;
    		//end here
		   if(bOlderVersion) then
		    	RegDBDeleteKey("Software\\ESQ\\" + svOldProduct); 
		    	RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "");
	    		RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "CompanyName");
				RegDBSetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "CompanyName", REGDB_STRING, svCompany, -1 );
				RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "UserName");
				RegDBSetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "UserName", REGDB_STRING, svName, -1 );
				RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME + "\\" + IFX_PRODUCT_VERSION, "");					 
			else
				RegDBGetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "CompanyName", nvType, svCompany, nvSize );
				RegDBGetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "UserName", nvType, svName, nvSize );
			endif;
			 // setup default status 
 			SetStatusWindow(0, "");
			PlaceWindow (STATUSDLG, (30*nvDx)/1024,(30*nvDy)/300, LOWER_RIGHT);
			Enable(STATUSDLG); 
			SetStatusExStaticText( "Please wait while the Wizard is installing "+svOldProduct+" to " + IFX_PRODUCT_NAME +"." ); 			
			StatusUpdate(ON, 100);                             
			FeatureReinstall();  
		case MODIFY:
			RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE); 
		    //Event Logger Service installation
	    	if(ComponentIsItemSelected (MEDIA, "AO 2.0\\Console\\Event Logger")) then
	    		//if ServiceExistsService ( "emslogsvc" )=FALSE then
		    		if RegDBKeyExist("Software\\ESQ\\EMSLoggerService")<0 then
			    		bEventLogger=FALSE;
		    		else
		    		//ServiceGetServiceState ( "emslogsvc", nvServiceState );
		    		//if nvServiceState=SERVICE_RUNNING then
		    			//ServiceStopService ( "emslogsvc" );
		    		 	 bEventLogger=TRUE;
			    		 szPath = WINSYSDIR ^ "net.exe";
						 LongPathToQuote( szPath, TRUE );
						 szCmd="stop emslogsvc";
						 LaunchAppAndWait(szPath,szCmd,WAIT);
		    		endif;
		    endif;
    		//end here
		    /*if(bOlderVersion) then
		    	RegDBDeleteKey("Software\\ESQ\\" + svOldProduct);
		    	RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "");
		    	RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "CompanyName");
				RegDBSetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "CompanyName", REGDB_STRING, svCompany, -1 );
				RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "UserName");
				RegDBSetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "UserName", REGDB_STRING, svName, -1 );
				RegDBCreateKeyEx  ( "Software\\ESQ\\" + IFX_PRODUCT_NAME + "\\" + IFX_PRODUCT_VERSION, "");
			else
				RegDBGetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "CompanyName", nvType, svCompany, nvSize );
				RegDBGetKeyValueEx( "Software\\ESQ\\" + IFX_PRODUCT_NAME, "UserName", nvType, svName, nvSize );
			endif;*/
			// setup default status 
 			SetStatusWindow(0, "");
			PlaceWindow (STATUSDLG, (30*nvDx)/1024,(30*nvDy)/300, LOWER_RIGHT);
			Enable(STATUSDLG); 	
			SetStatusExStaticText( "Please wait while the Wizard is installing "+svOldProduct+" to " + IFX_PRODUCT_NAME +"." );  		
			StatusUpdate(ON, 100);
			if(bOlderVersion) then
				FeatureReinstall();
				FeatureTransferData(MEDIA);
			else   
			    FeatureReinstall();
				FeatureTransferData(MEDIA);
			endif;				
    endswitch;
    //Disable(STATUSEX); 
end;

