		RegDBSetKeyValueEx( "Software\\ESQ\\AO", "TokenFilesPath", REGDB_STRING, svOCCTokenPath, -1 );
	endif; */
	
    szDLLName = SUPPORTDIR^"OVOPSDLL.DLL";
	UnUseDLL(szDLLName);
	CreateAODBDSN();         
	RemoveReporterSchedulerClass();
	DeleteFile(TARGETDIR ^ "Back end" ^ "j2re-1_4_2_03-windows-i586-p.exe");
	DeleteFile(TARGETDIR ^ "Back end" ^"MDAC_TYPE.EXE");
