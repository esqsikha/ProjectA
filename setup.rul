		RegDBSetKeyValueEx( "Software\\ESQ\\AO", "TokenFilesPath", REGDB_STRING, svOCCTokenPath, -1 ); 
	else
		svOCCTokenPath=svSysdir ^ "All Users" ^ "Application Data" ^ "ESQ" ^ "OpenNET" ^"AO" ^ "AO";
	    RegDBSetDefaultRoot(HKEY_LOCAL_MACHINE);
